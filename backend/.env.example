# PRAVIA OS — Environment Variables

# Database (PostgreSQL / Supabase)
# El parámetro schema evita que Prisma consulte accidentalmente public.
PRAVIA_DATABASE_MODE=cloud
PRAVIA_PRIMARY_DATABASE=cloud
PRAVIA_DATABASE_SCHEMA=pravia_os
# DATABASE_URL/DIRECT_URL se conservan para Prisma CLI y compatibilidad.
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=pravia_os"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=pravia_os"
CLOUD_DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=pravia_os"
CLOUD_DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=pravia_os"
LOCAL_DATABASE_URL=""
LOCAL_DIRECT_URL=""

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Storage (actual: Supabase; preparado para futura implementación local/híbrida)
STORAGE_MODE=cloud
PRAVIA_PRIMARY_STORAGE=cloud
LOCAL_STORAGE_PATH=""
LOCAL_STORAGE_SIGNING_SECRET=""
# Vacío para despliegue same-origin; usar origen absoluto si frontend/API están separados.
PUBLIC_API_URL=""

# Compensación durable de cargas temporales (apagado por defecto)
STORAGE_COMPENSATION_WORKER_ENABLED="false"
STORAGE_COMPENSATION_POLL_MS="15000"
STORAGE_COMPENSATION_MAX_ATTEMPTS="5"
STORAGE_COMPENSATION_STALE_MS="300000"

# Autenticación (mínimo 32 caracteres aleatorios; no reutilizar otras claves)
AUTH_JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Webhook privado opcional para entregar enlaces de recuperación
PASSWORD_RECOVERY_WEBHOOK_URL=""
PASSWORD_RECOVERY_URL="http://localhost:5173/recuperar-acceso"
AUTH_ALLOW_DEV_RECOVERY_TOKEN="false"

# Server
PORT=3001
NODE_ENV=development
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# AI documental (solo backend; nunca exponer la clave en el frontend)
AI_DOCUMENT_PROVIDER=OPENAI
AI_DOCUMENT_MODEL=gpt-5.4-nano
OPENAI_DOCUMENT_MODEL=gpt-5.4-nano
OPENAI_ESCALATION_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=high
OPENAI_API_KEY=""
AI_DOCUMENT_TIMEOUT_MS=120000
AI_DOCUMENT_MAX_RETRIES=2

# Pruebas E2E (solo entorno aislado; nunca apuntar a la base cloud vigente)
E2E_API_URL="http://127.0.0.1:3001/api"
E2E_EMAIL=""
E2E_PASSWORD=""
E2E_ALLOW_MUTATIONS=""
E2E_TARGET_KIND="local"
E2E_RUN_PAID_AI="false"
E2E_AI_FIXTURE_PATH=""
