{
  "name": "pravia-os-backend",
  "version": "1.0.0",
  "description": "PRAVIA OS — Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "check:env": "ts-node scripts/check-env.ts",
    "check:db": "ts-node scripts/verify-runtime-database.ts",
    "db:verify": "ts-node scripts/verify-runtime-database.ts",
    "db:backup": "ts-node scripts/db-backup.ts",
    "db:restore": "ts-node scripts/db-restore.ts",
    "db:init-empty": "ts-node scripts/db-init-empty.ts",
    "storage:verify": "ts-node scripts/verify-storage.ts",
    "check:secrets": "ts-node scripts/check-secrets.ts",
    "auth:set-password": "ts-node scripts/set-user-password.ts",
    "test": "vitest run --exclude 'src/integration/**'",
    "test:integration": "vitest run src/integration",
    "eval:ai": "ts-node scripts/evaluate-ai-fixtures.ts",
    "e2e:critical": "ts-node scripts/e2e-critical-flows.ts",
    "e2e:seed": "ts-node scripts/seed-e2e.ts",
    "finance:audit-legacy": "ts-node scripts/audit-legacy-finance.ts",
    "projects:migrate-legacy": "ts-node scripts/migrate-legacy-projects.ts",
    "projects:register-template": "ts-node scripts/register-project-template.ts",
    "test:watch": "vitest",
    "seed": "ts-node prisma/seed.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
