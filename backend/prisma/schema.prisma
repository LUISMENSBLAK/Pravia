  nacionalidad_condicion String?                        @db.VarChar(200)
  regimen_simplificado   Boolean?
  actividad_vulnerable   Boolean?
  requiere_bc            Boolean                        @default(false)
  requiere_riesgo        Boolean                        @default(false)
  requiere_pep           Boolean                        @default(false)
  requiere_perfil        Boolean                        @default(false)
  requiere_alto_riesgo   Boolean                        @default(false)
  vigencia_desde         DateTime?
  condiciones_json       Json?
  activa                 Boolean                        @default(true)
  creado_por_id          String                         @db.Uuid
  created_at             DateTime                       @default(now())
  organization           Organization                   @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creadoPor              User                           @relation("CatalogoNormativaRevisionCreator", fields: [creado_por_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  artefacto              CatalogoArtefacto              @relation(fields: [artefacto_id, organization_id], references: [id, organization_id], onDelete: Restrict)
  reglas                 CatalogoArtefactoRegla[]
  pendientesExp006       ExpedienteArtefactoPendiente[] @relation("Exp006PendingNormativeRevision")

  @@unique([artefacto_id, revision], map: "uq_catalogo_normativa_artefacto_revision")
  @@unique([organization_id, codigo_revision, revision], map: "uq_catalogo_normativa_codigo_revision")
  @@unique([id, organization_id], map: "uq_catalogo_normativa_id_org")
  @@index([organization_id, activa, vigencia_desde], map: "idx_catalogo_normativa_vigencia")
  @@index([artefacto_id, organization_id], map: "idx_catalogo_normativa_artefacto_org")
  @@index([creado_por_id], map: "idx_catalogo_normativa_creador")
  @@map("catalogo_normativa_revisiones")
}

