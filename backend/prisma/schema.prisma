model Compareciente {
  id              String               @id @default(uuid()) @db.Uuid
  tipo_persona    TipoPersona          @default(FISICA)
  nombre_busqueda String // Normalizado sin acentos, mayúsculas para índice rápido
  estatus         ComparecienteEstatus @default(ACTIVO)
  creado_por_id   String               @db.Uuid
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  archived_at     DateTime?
  version         Int                  @default(1)

  creado_por User @relation("ComparecienteCreador", fields: [creado_por_id], references: [id], onDelete: Restrict)

  personaFisica    PersonaFisica?
  personaMoral     PersonaMoral?
