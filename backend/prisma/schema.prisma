  clave              String                          @unique @db.VarChar(100)
  nombre             String                          @db.VarChar(150)
  descripcion        String?
  activo             Boolean?                        @default(true)
  created_at         DateTime?                       @default(now()) @db.Timestamptz(6)
  expedienteVinculos ExpedienteCompareciente[]
  tipoActoCaracteres TipoActoCaracterCompareciente[]

  @@map("caracteres_compareciente")
}

model TipoActoCaracterCompareciente {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo_acto_id String                @db.Uuid
  caracter_id  String                @db.Uuid
  sugerido     Boolean?              @default(true)
  orden        Int?                  @default(0)
  caracter     CaracterCompareciente @relation(fields: [caracter_id], references: [id], onUpdate: NoAction)
  tipo_acto    TipoActo              @relation(fields: [tipo_acto_id], references: [id], onUpdate: NoAction)

  @@unique([tipo_acto_id, caracter_id], map: "uq_tipo_acto_caracter")
  @@index([caracter_id], map: "idx_tipo_acto_caracter_caracter_fk")
  @@map("tipo_acto_caracteres_compareciente")
}

model ExpedienteCompareciente {
  id                                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                   String?                    @db.Uuid
  expediente_id                     String                     @db.Uuid
  expediente_acto_id                String?                    @db.Uuid
  compareciente_id                  String                     @db.Uuid
  caracter_id                       String                     @db.Uuid
  forma_comparecencia               FormaComparecencia?        @default(PROPIO_DERECHO)
  participacion_porcentaje          Decimal?                   @db.Decimal(9, 6)
  orden_comparecencia               Int?                       @default(1)
  es_principal                      Boolean?                   @default(true)
  observaciones                     String?
  estatus                           String?                    @default("ACTIVO") @db.VarChar(50)
  creado_por_id                     String                     @db.Uuid
  created_at                        DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime?                  @default(now()) @updatedAt @db.Timestamptz(6)
  archived_at                       DateTime?                  @db.Timestamptz(6)
  archived_by_id                    String?                    @db.Uuid
  motivo_desvinculacion             String?
  idempotency_key                   String?
  unlink_idempotency_key            String?
  datos_validados                   Boolean                    @default(false)
  validado_por_id                   String?                    @db.Uuid
  validado_at                       DateTime?                  @db.Timestamptz(6)
  caracter                          CaracterCompareciente      @relation(fields: [caracter_id], references: [id], onUpdate: NoAction)
  compareciente                     Compareciente              @relation(fields: [compareciente_id], references: [id], onUpdate: NoAction)
  creado_por                        User                       @relation("ExpedienteComparecienteCreador", fields: [creado_por_id], references: [id], onUpdate: NoAction)
  expediente                        Expediente                 @relation(fields: [expediente_id], references: [id], onUpdate: NoAction)
  expedienteActo                    ExpedienteActo?            @relation(fields: [expediente_acto_id], references: [id], onDelete: Restrict)
  validado_por                      User?                      @relation("ExpedienteComparecienteValidador", fields: [validado_por_id], references: [id])
  representacionesComoRepresentante ExpedienteRepresentacion[] @relation("ExpedienteRepresentanteVinculo")
  representacionesComoRepresentado  ExpedienteRepresentacion[] @relation("ExpedienteRepresentadoVinculo")

  @@unique([organization_id, expediente_id, idempotency_key], map: "uq_exp_comparecientes_idempotency")
  @@unique([organization_id, expediente_id, unlink_idempotency_key], map: "uq_exp_comparecientes_unlink_idempotency")
  @@index([organization_id, expediente_id, expediente_acto_id, estatus], map: "idx_exp_comparecientes_tenant_act_status")
  @@index([expediente_acto_id], map: "idx_exp_comparecientes_acto_fk")
  @@index([caracter_id], map: "idx_exp_comparecientes_caracter_fk")
  @@index([compareciente_id], map: "idx_exp_comparecientes_compareciente_fk")
  @@index([creado_por_id], map: "idx_exp_comparecientes_creador_fk")
  @@index([validado_por_id], map: "idx_exp_comparecientes_validador_fk")
  @@map("expediente_comparecientes")
}

model ExpedienteRepresentacion {
  id                                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                           String?                  @db.Uuid
  expediente_id                             String                   @db.Uuid
  representado_compareciente_id             String                   @db.Uuid
  representante_compareciente_id            String                   @db.Uuid
  expediente_compareciente_representado_id  String?                  @db.Uuid
  expediente_compareciente_representante_id String?                  @db.Uuid
  caracter_representacion_id                String?                  @db.Uuid
  cargo_o_caracter_descripcion              String                   @db.VarChar(150)
  instrumento_representacion_id             String?                  @db.Uuid
  facultades_aplicables                     String?
  fecha_vigencia                            DateTime?                @db.Date
  validada                                  Boolean?                 @default(false)
  creado_por_id                             String                   @db.Uuid
  validado_por_id                           String?                  @db.Uuid
  observaciones                             String?
  created_at                                DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime?                @default(now()) @updatedAt @db.Timestamptz(6)
  archived_at                               DateTime?                @db.Timestamptz(6)
  caracterRepresentacion                    CaracterRepresentacion?  @relation(fields: [caracter_representacion_id], references: [id], onUpdate: NoAction)
  creado_por                                User                     @relation("ExpedienteRepresentacionCreador", fields: [creado_por_id], references: [id], onUpdate: NoAction)
  expedienteComparecienteRepresentante      ExpedienteCompareciente? @relation("ExpedienteRepresentanteVinculo", fields: [expediente_compareciente_representante_id], references: [id], onUpdate: NoAction, map: "fk_exp_rep_compareciente_representante")
  expedienteComparecienteRepresentado       ExpedienteCompareciente? @relation("ExpedienteRepresentadoVinculo", fields: [expediente_compareciente_representado_id], references: [id], onUpdate: NoAction, map: "fk_exp_rep_compareciente_representado")
  expediente                                Expediente               @relation(fields: [expediente_id], references: [id], onUpdate: NoAction)
  instrumento                               PersonaMoralInstrumento? @relation(fields: [instrumento_representacion_id], references: [id], onUpdate: NoAction)
  representado                              Compareciente            @relation("RepresentadoExpediente", fields: [representado_compareciente_id], references: [id], onUpdate: NoAction)
  representante                             Compareciente            @relation("RepresentanteExpediente", fields: [representante_compareciente_id], references: [id], onUpdate: NoAction)
  validado_por                              User?                    @relation("ExpedienteRepresentacionValidador", fields: [validado_por_id], references: [id], onUpdate: NoAction)

  @@index([caracter_representacion_id], map: "idx_exp_rep_caracter_fk")
  @@index([creado_por_id], map: "idx_exp_rep_creador_fk")
  @@index([expediente_id], map: "idx_exp_rep_expediente_fk")
  @@index([instrumento_representacion_id], map: "idx_exp_rep_instrumento_fk")
  @@index([representado_compareciente_id], map: "idx_exp_rep_representado_fk")
  @@index([representante_compareciente_id], map: "idx_exp_rep_representante_fk")
  @@index([validado_por_id], map: "idx_exp_rep_validador_fk")
  @@index([expediente_compareciente_representado_id], map: "idx_exp_rep_vinculo_representado_fk")
  @@index([expediente_compareciente_representante_id], map: "idx_exp_rep_vinculo_representante_fk")
  @@map("expediente_representaciones")
}

model ExpedienteRequisitoDoc {
  id                  String                      @id @default(uuid()) @db.Uuid
  organization_id     String?                     @db.Uuid
  expediente_id       String                      @db.Uuid
  nombre              String
