model HonorarioGenerado {
  id                    String                   @id @default(uuid()) @db.Uuid
  organization_id       String?                  @db.Uuid
  clave_origen          String                   @unique
  cotizacion_id         String                   @unique @db.Uuid
  cotizacion_version_id String                   @db.Uuid
  expediente_id         String?                  @db.Uuid
  notaria_id            String?                  @db.Uuid
  responsable_id        String?                  @db.Uuid
  monto                 Decimal                  @db.Decimal(14, 2)
  fecha_reconocimiento  DateTime                 @default(now())
  fecha_vencimiento     DateTime?
  evento_reconocimiento String                   @default("COTIZACION_ACEPTADA")
  estado                EstadoHonorarioGenerado  @default(RECONOCIDO)
  reconocido_por_id     String                   @db.Uuid
  created_at            DateTime                 @default(now())
  updated_at            DateTime                 @updatedAt
  cotizacion            Cotizacion               @relation(fields: [cotizacion_id], references: [id])
  cotizacionVersion     CotizacionVersion        @relation(fields: [cotizacion_version_id], references: [id])
  expediente            Expediente?              @relation(fields: [expediente_id], references: [id])
