/// Estado operativo previo a la aplicación contable de un ingreso. La evidencia
/// reportada nunca constituye por sí misma un movimiento financiero aplicado.
model ExpedienteIngresoReportado {
  id                           String                           @id @default(uuid()) @db.Uuid
  organization_id              String                           @db.Uuid
  expediente_id                String                           @db.Uuid
  estado                       ExpedienteIngresoReportadoEstado @default(PENDIENTE_APLICACION)
  concepto_contexto            String?
  referencia_solicitud         String?
  monto_reportado              Decimal?                         @db.Decimal(14, 2)
  monto_validado               Decimal?                         @db.Decimal(14, 2)
  honorarios_aplicados         Decimal?                         @db.Decimal(14, 2)
  impuestos_derechos_aplicados Decimal?                         @db.Decimal(14, 2)
  fecha_ingreso                DateTime?
  forma_pago                   String?
  referencia                   String?
  cuenta_id                    String?                          @db.Uuid
  movimiento_id                String?                          @unique @db.Uuid
  reportado_por_id             String                           @db.Uuid
  aplicado_por_id              String?                          @db.Uuid
  aplicado_at                  DateTime?
  anulado_por_id               String?                          @db.Uuid
  anulado_at                   DateTime?
  motivo_anulacion             String?
  idempotency_key              String
  version                      Int                              @default(1)
  created_at                   DateTime                         @default(now())
  updated_at                   DateTime                         @updatedAt
  expediente                   Expediente                       @relation(fields: [expediente_id], references: [id], onDelete: Restrict)
  cuenta                       CuentaFinanciera?                @relation(fields: [cuenta_id], references: [id], onDelete: Restrict)
  movimiento                   MovimientoFinanciero?            @relation(fields: [movimiento_id], references: [id], onDelete: Restrict)
  reportadoPor                 User                             @relation("Exp008IngresoReportador", fields: [reportado_por_id], references: [id], onDelete: Restrict)
  aplicadoPor                  User?                            @relation("Exp008IngresoAplicador", fields: [aplicado_por_id], references: [id], onDelete: Restrict)
  anuladoPor                   User?                            @relation("Exp008IngresoAnulador", fields: [anulado_por_id], references: [id], onDelete: Restrict)
  documentos                   ExpedienteFinanzaDocumento[]
  propuestasIA                 ExpedienteFinanzaPropuestaIA[]

  @@unique([organization_id, expediente_id, idempotency_key], map: "uq_exp008_ingreso_idempotency")
  @@index([organization_id, expediente_id, estado, created_at], map: "idx_exp008_ingreso_pending")
  @@index([cuenta_id], map: "idx_exp008_ingreso_cuenta_fk")
  @@index([reportado_por_id], map: "idx_exp008_ingreso_reportador_fk")
  @@index([aplicado_por_id], map: "idx_exp008_ingreso_aplicador_fk")
  @@index([anulado_por_id], map: "idx_exp008_ingreso_anulador_fk")
  @@map("expediente_ingresos_reportados")
}

/// Solicitud operativa. El egreso definitivo existe sólo en MovimientoFinanciero.
model ExpedienteSolicitudPago {
  id                 String                         @id @default(uuid()) @db.Uuid
  organization_id    String                         @db.Uuid
  expediente_id      String                         @db.Uuid
  via                ExpedienteSolicitudPagoVia
  estado             ExpedienteSolicitudPagoEstado  @default(PENDIENTE)
  concepto           String
  importe            Decimal                        @db.Decimal(14, 2)
  dependencia        String?
  beneficiario       String?
  referencia         String?
  fecha_limite       DateTime?
  notas              String?
  categoria_id       String?                        @db.Uuid
  cuenta_id          String?                        @db.Uuid
  movimiento_id      String?                        @unique @db.Uuid
  formato_version_id String?                        @db.Uuid
  formato_fuente     String?
  creado_por_id      String                         @db.Uuid
  pagado_por_id      String?                        @db.Uuid
  pagado_at          DateTime?
  anulado_por_id     String?                        @db.Uuid
  anulado_at         DateTime?
  motivo_anulacion   String?
  idempotency_key    String
  version            Int                            @default(1)
  created_at         DateTime                       @default(now())
  updated_at         DateTime                       @updatedAt
