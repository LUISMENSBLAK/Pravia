  persona_moral_id            String                      @db.Uuid
  tipo_instrumento            TipoInstrumentoMoral        @default(CONSTITUCION)
  estatus_instrumento         EstatusInstrumento          @default(VIGENTE_REPRESENTACION)
  numero                      String?                     @db.VarChar(50)
  fecha                       DateTime?                   @db.Date
  notario_o_corredor          String?                     @db.VarChar(150)
  numero_notaria_o_correduria String?                     @db.VarChar(50)
  municipio                   String?                     @db.VarChar(100)
  estado                      String?                     @db.VarChar(100)
  folio_mercantil             String?                     @db.VarChar(100)
  fecha_inscripcion           DateTime?                   @db.Date
  documento_soporte_id        String?                     @db.Uuid
  vigente                     Boolean?                    @default(true)
  observaciones               String?
  creado_por_id               String                      @db.Uuid
  validado_por_id             String?                     @db.Uuid
