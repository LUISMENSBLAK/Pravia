generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                                String                                       @id @default(uuid()) @db.Uuid
  name                              String
  status                            String                                       @default("ACTIVE")
  created_at                        DateTime                                     @default(now())
  updated_at                        DateTime                                     @updatedAt
  memberships                       OrganizationMembership[]
  sessions                          AuthSession[]
  expedienteActos                   ExpedienteActo[]
  predios                           Predio[]
  predioColindancias                PredioColindancia[]
  expedientePredios                 ExpedientePredio[]
  expedienteActoPredios             ExpedienteActoPredio[]
  predioDocumentos                  PredioDocumento[]
  predioDatosFuente                 PredioDatoFuente[]
  exp006Pendientes                  ExpedienteArtefactoPendiente[]               @relation("Exp006PendingOrganization")
  exp006Documentos                  ExpedienteArtefactoDocumento[]               @relation("Exp006DocumentOrganization")
  presupuestos                      ExpedientePresupuesto[]
  presupuestoConceptos              ExpedientePresupuestoConcepto[]
  presupuestoDistribuciones         ExpedientePresupuestoDistribucion[]
  presupuestoDocumentos             ExpedientePresupuestoDocumento[]
  expedienteActividades             ExpedienteActividad[]
  prospectoTransiciones             ProspectoTransicion[]
  prospectoFuentes                  ProspectoFuenteNotarial[]
  cotizacionTransiciones            CotizacionTransicion[]
  complianceLegalRules              ComplianceLegalRule[]
  complianceRuleRevisions           ComplianceLegalRuleRevision[]
  expedienteComplianceStates        ExpedienteComplianceState[]
  complianceRuleResults             ComplianceRuleResult[]
  complianceAlertLeads              ComplianceAlertLeadRevision[]
  complianceRequirements            ComplianceRequirement[]
  complianceAlerts                  ComplianceAlert[]
  bcOwnershipStructures             PersonaMoralOwnershipStructure[]
  bcSnapshots                       ComplianceBcStructureSnapshot[]
  bcFormatMappings                  ComplianceBcFormatMapping[]
  questionnaireAssessments          ComplianceQuestionnaireAssessment[]
  questionnaireRevisions            ComplianceQuestionnaireAssessmentRevision[]
  riskMethodologies                 ComplianceRiskMethodology[]
  riskMethodologyRevisions          ComplianceRiskMethodologyRevision[]
  operationPayments                 ComplianceOperationPayment[]
  operationPaymentRevisions         ComplianceOperationPaymentRevision[]
  operationPaymentActs              ComplianceOperationPaymentAct[]
  operationPaymentParties           ComplianceOperationPaymentParty[]
  operationPaymentEvidence          ComplianceOperationPaymentEvidence[]
  operationPaymentVerifications     ComplianceOperationPaymentVerification[]
  operationPaymentVerificationRules ComplianceOperationPaymentVerificationRule[]
  complianceOfficialActivations     ComplianceOfficialDefinitionActivation[]
  complianceObligationTriggers      ComplianceObligationTrigger[]
  complianceNoticeFicheRevisions    ComplianceNoticeFicheRevision[]
  complianceOfficialProducts        ComplianceOfficialProduct[]
  complianceNoticePresentations     ComplianceNoticePresentation[]
  complianceNoticeAcknowledgements  ComplianceNoticeAcknowledgement[]
  complianceRequirementExceptions   ComplianceRequirementException[]
  complianceAssistedReviews         ComplianceAssistedReview[]
  configuracionConceptosActividad   ConfiguracionConceptoActividad[]
  catalogoInstitucionRespuestas     CatalogoInstitucionTipoRespuesta[]
  catalogoNormativaRevisiones       CatalogoNormativaRevision[]
  catalogoBibliotecaImportaciones   CatalogoBibliotecaImportacion[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id                                      String                                      @id @default(uuid()) @db.Uuid
  organization_id                         String                                      @db.Uuid
  user_id                                 String                                      @db.Uuid
  rol                                     Role
  status                                  String                                      @default("ACTIVE")
  created_at                              DateTime                                    @default(now())
  updated_at                              DateTime                                    @updatedAt
  organization                            Organization                                @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user                                    User                                        @relation(fields: [user_id], references: [id], onDelete: Restrict)
  sessions                                AuthSession[]
  prospectoTransiciones                   ProspectoTransicion[]
  prospectoFuentes                        ProspectoFuenteNotarial[]
  cotizacionTransiciones                  CotizacionTransicion[]
  complianceLegalRulesCreated             ComplianceLegalRule[]                       @relation("ComplianceLegalRuleCreatorMembership")
  complianceRuleRevisionsCreated          ComplianceLegalRuleRevision[]               @relation("ComplianceRuleRevisionCreatorMembership")
  complianceRuleRevisionsVerified         ComplianceLegalRuleRevision[]               @relation("ComplianceRuleRevisionVerifierMembership")
  complianceRuleRevisionsActivated        ComplianceLegalRuleRevision[]               @relation("ComplianceRuleRevisionActivatorMembership")
  expedienteComplianceStatesUpdated       ExpedienteComplianceState[]                 @relation("ExpedienteComplianceStateUpdaterMembership")
  complianceAlertLeadsCreated             ComplianceAlertLeadRevision[]               @relation("ComplianceAlertLeadCreatorMembership")
  complianceAlertsResponsible             ComplianceAlert[]                           @relation("ComplianceAlertResponsibleMembership")
  complianceAlertsResolved                ComplianceAlert[]                           @relation("ComplianceAlertResolverMembership")
  bcStructuresCreated                     PersonaMoralOwnershipStructure[]            @relation("BcStructureCreatorMembership")
  bcStructuresUpdated                     PersonaMoralOwnershipStructure[]            @relation("BcStructureUpdaterMembership")
  bcEdgesConfirmed                        PersonaMoralOwnershipEdge[]                 @relation("BcEdgeConfirmerMembership")
  bcControlsConfirmed                     PersonaMoralControlFact[]                   @relation("BcControlConfirmerMembership")
  bcReconciliationsDecided                PersonaMoralStructureReconciliation[]       @relation("BcReconciliationDeciderMembership")
  bcSnapshotsCaptured                     ComplianceBcStructureSnapshot[]             @relation("BcSnapshotActorMembership")
  bcEvaluationsCreated                    ComplianceBcEvaluation[]                    @relation("BcEvaluationActorMembership")
  bcAiProposalsCreated                    ComplianceBcAiProposal[]                    @relation("BcAiProposalCreatorMembership")
  bcAiProposalsDecided                    ComplianceBcAiProposal[]                    @relation("BcAiProposalDeciderMembership")
  bcFormatMappingsCreated                 ComplianceBcFormatMapping[]                 @relation("BcFormatCreatorMembership")
  bcFormatMappingsUpdated                 ComplianceBcFormatMapping[]                 @relation("BcFormatUpdaterMembership")
  complianceExceptionsAuthorized          ComplianceRequirementException[]            @relation("ComplianceExceptionAuthorizerMembership")
  bcSocietyTargetsCreated                 ExpedienteSocietyTarget[]                   @relation("BcSocietyTargetCreatorMembership")
  questionnaireAssessmentsCreated         ComplianceQuestionnaireAssessment[]         @relation("QuestionnaireAssessmentCreatorMembership")
  questionnaireRevisionsCreated           ComplianceQuestionnaireAssessmentRevision[] @relation("QuestionnaireRevisionCreatorMembership")
  questionnaireRevisionsFinalized         ComplianceQuestionnaireAssessmentRevision[] @relation("QuestionnaireRevisionFinalizerMembership")
  riskMethodologiesCreated                ComplianceRiskMethodology[]                 @relation("RiskMethodologyCreatorMembership")
  riskMethodologyRevisionsCreated         ComplianceRiskMethodologyRevision[]         @relation("RiskMethodologyRevisionCreatorMembership")
  riskMethodologyRevisionsVerified        ComplianceRiskMethodologyRevision[]         @relation("RiskMethodologyRevisionVerifierMembership")
  riskMethodologyRevisionsActivated       ComplianceRiskMethodologyRevision[]         @relation("RiskMethodologyRevisionActivatorMembership")
  operationPaymentsCreated                ComplianceOperationPayment[]                @relation("OperationPaymentCreatorMembership")
  operationPaymentRevisionsCreated        ComplianceOperationPaymentRevision[]        @relation("OperationPaymentRevisionCreatorMembership")
  operationPaymentRevisionsConfirmed      ComplianceOperationPaymentRevision[]        @relation("OperationPaymentRevisionConfirmerMembership")
  operationPaymentVerificationsCreated    ComplianceOperationPaymentVerification[]    @relation("OperationPaymentVerificationCreatorMembership")
  operationPaymentVerificationsConfirmed  ComplianceOperationPaymentVerification[]    @relation("OperationPaymentVerificationConfirmerMembership")
  complianceOfficialActivationsCreated    ComplianceOfficialDefinitionActivation[]    @relation("H6OfficialActivationActor")
  complianceFicheRevisionsCreated         ComplianceNoticeFicheRevision[]             @relation("H6FicheRevisionActor")
  complianceOfficialProductsCreated       ComplianceOfficialProduct[]                 @relation("H6OfficialProductActor")
  complianceNoticePresentationsCreated    ComplianceNoticePresentation[]              @relation("H6NoticePresentationActor")
  complianceNoticeAcknowledgementsCreated ComplianceNoticeAcknowledgement[]           @relation("H6NoticeAcknowledgementActor")
  complianceAssistedReviewsExecuted       ComplianceAssistedReview[]                  @relation("H9AssistedReviewActor")
  configuracionConceptosResponsable       ConfiguracionConceptoActividad[]            @relation("CfgConceptResponsibleMembership")
  seguimientoActividadesCompletadas       ExpedienteSeguimientoActividad[]            @relation("SeguimientoCompletedByMembership")

  @@unique([organization_id, user_id])
  @@index([user_id, status])
  @@index([organization_id, status])
  @@map("organization_memberships")
}

model User {
  id                                     String                                 @id @default(uuid()) @db.Uuid
  email                                  String                                 @unique
  password_hash                          String
  nombre                                 String
  apellido                               String
  rol                                    Role                                   @default(ABOGADO)
  avatar_url                             String?
  activo                                 Boolean                                @default(true)
  created_at                             DateTime                               @default(now())
  updated_at                             DateTime                               @updatedAt
  password_changed_at                    DateTime?
  failed_login_attempts                  Int                                    @default(0)
  locked_until                           DateTime?
  last_login_at                          DateTime?
  requires_password_change               Boolean                                @default(true)
  telefono                               String?
  aiUsageLogs                            AIUsageLog[]
  assistantConversations                 AssistantConversation[]                @relation("AssistantConversationOwner")
  assistantAttachments                   AssistantAttachment[]                  @relation("AssistantAttachmentUploader")
  auditLogs                              AuditLog[]
  authSessions                           AuthSession[]
  cargasTemporales                       CargaTemporalDocumento[]               @relation("CargaTemporalUsuario")
  comparecienteAltaSessions              ComparecienteAltaSession[]             @relation("ComparecienteAltaSessionUsuario")
  contactosComparecienteCreados          ComparecienteContacto[]                @relation("ContactoCreador")
  datosFuenteConfirmados                 ComparecienteDatoFuente[]              @relation("DatoFuenteConfirmador")
  comparecienteVinculosCreados           ComparecienteDocumento[]               @relation("ComparecienteDocCreador")
  comparecienteDocsValidados             ComparecienteDocumento[]               @relation("ComparecienteDocValidador")
  domiciliosComparecienteCreados         ComparecienteDomicilio[]               @relation("DomicilioCreador")
  identificacionesComparecienteCreadas   ComparecienteIdentificacion[]          @relation("IdentificacionCreador")
  identificacionesComparecienteValidadas ComparecienteIdentificacion[]          @relation("IdentificacionValidador")
  comparecientesCreados                  Compareciente[]                        @relation("ComparecienteCreador")
  complianceDecisions                    ComplianceDecision[]                   @relation("ComplianceDecisionActor")
  complianceEvidenceAdded                ComplianceEvidence[]                   @relation("ComplianceEvidenceAdder")
  complianceReviewsCreated               ComplianceReview[]                     @relation("ComplianceReviewCreator")
  complianceReviewsReviewed              ComplianceReview[]                     @relation("ComplianceReviewReviewer")
  complianceRulesApproved                ComplianceRuleSet[]                    @relation("ComplianceRuleApprover")
  complianceRulesCreated                 ComplianceRuleSet[]                    @relation("ComplianceRuleCreator")
  complianceOfficialDefinitionsCreated   ComplianceOfficialDefinition[]         @relation("H6OfficialDefinitionCreator")
  complianceOfficialRevisionsCreated     ComplianceOfficialDefinitionRevision[] @relation("H6OfficialRevisionCreator")
  complianceOfficialRevisionsVerified    ComplianceOfficialDefinitionRevision[] @relation("H6OfficialRevisionVerifier")
  comprobantesAnulados                   ComprobanteFinanciero[]                @relation("ComprobanteAnulador")
  comprobantesRegistrados                ComprobanteFinanciero[]                @relation("ComprobanteRegistrador")
  comunicacionVinculosCreados            ComunicacionDocumento[]                @relation("ComunicacionDocCreador")
  comunicaciones                         Comunicacion[]
  conciliacionesRegistradas              ConciliacionFinanciera[]               @relation("ConciliacionActor")
  cotizacionVinculosCreados              CotizacionDocumento[]                  @relation("CotizacionDocCreador")
  seguimientosCotizaciones               CotizacionSeguimiento[]
  cotizaciones                           Cotizacion[]
  cuentasFinancierasCreadas              CuentaFinanciera[]                     @relation("CuentaFinancieraCreador")
  documentosSubidos                      Documento[]
  outboxEventosDisparados                DomainEventOutbox[]                    @relation("OutboxActor")
  eventosCancelados                      EventoAgenda[]                         @relation("EventoCanceladoPor")
  eventos                                EventoAgenda[]                         @relation("EventoResponsable")
  expedienteActividades                  ExpedienteActividad[]
  expedienteComparecientesCreados        ExpedienteCompareciente[]              @relation("ExpedienteComparecienteCreador")
  expedienteComparecientesValidados      ExpedienteCompareciente[]              @relation("ExpedienteComparecienteValidador")
  expedienteVinculosCreados              ExpedienteDocumento[]                  @relation("ExpedienteDocCreador")
  expedienteSnapshotsCongelados          ExpedienteDocumentoSnapshot[]          @relation("ExpedienteSnapshotActor")
  entregasRegistradas                    ExpedienteEntrega[]                    @relation("ExpedienteEntregaRegistrador")
  expedienteRepresentacionesCreadas      ExpedienteRepresentacion[]             @relation("ExpedienteRepresentacionCreador")
  expedienteRepresentacionesValidadas    ExpedienteRepresentacion[]             @relation("ExpedienteRepresentacionValidador")
  expedientes                            Expediente[]                           @relation("ExpedienteAbogado")
  expedientesArchivados                  Expediente[]                           @relation("ExpedienteArchivedBy")
  expedientesCreados                     Expediente[]                           @relation("ExpedienteCreador")
  expedienteActosCreados                 ExpedienteActo[]                       @relation("ExpedienteActoCreador")
  expedienteActosRetirados               ExpedienteActo[]                       @relation("ExpedienteActoRetirador")
  prediosCreados                         Predio[]                               @relation("PredioCreador")
  prediosActualizados                    Predio[]                               @relation("PredioActualizador")
  expedientePrediosCreados               ExpedientePredio[]                     @relation("ExpedientePredioCreador")
  exp006PendientesCreados                ExpedienteArtefactoPendiente[]         @relation("Exp006PendingCreator")
  exp006PendientesValidados              ExpedienteArtefactoPendiente[]         @relation("Exp006PendingValidator")
  exp006DocumentosCreados                ExpedienteArtefactoDocumento[]         @relation("Exp006DocumentCreator")
  presupuestosCreados                    ExpedientePresupuesto[]                @relation("PresupuestoCreador")
  presupuestosActualizados               ExpedientePresupuesto[]                @relation("PresupuestoActualizador")
  presupuestoDocumentosGenerados         ExpedientePresupuestoDocumento[]       @relation("PresupuestoDocumentoGenerador")
  presupuestoDocumentosEliminados        ExpedientePresupuestoDocumento[]       @relation("PresupuestoDocumentoEliminador")
  ingresosExp008Reportados               ExpedienteIngresoReportado[]           @relation("Exp008IngresoReportador")
  ingresosExp008Aplicados                ExpedienteIngresoReportado[]           @relation("Exp008IngresoAplicador")
  ingresosExp008Anulados                 ExpedienteIngresoReportado[]           @relation("Exp008IngresoAnulador")
  solicitudesExp008Creadas               ExpedienteSolicitudPago[]              @relation("Exp008SolicitudCreador")
  solicitudesExp008Pagadas               ExpedienteSolicitudPago[]              @relation("Exp008SolicitudPagador")
  solicitudesExp008Anuladas              ExpedienteSolicitudPago[]              @relation("Exp008SolicitudAnulador")
  documentosExp008Vinculados             ExpedienteFinanzaDocumento[]           @relation("Exp008DocumentoVinculador")
  documentosExp008Retirados              ExpedienteFinanzaDocumento[]           @relation("Exp008DocumentoRetirador")
  propuestasExp008Revisadas              ExpedienteFinanzaPropuestaIA[]         @relation("Exp008PropuestaRevisor")
  expedientePrediosRetirados             ExpedientePredio[]                     @relation("ExpedientePredioRetirador")
  predioDocumentosCreados                PredioDocumento[]                      @relation("PredioDocumentoCreador")
  predioDocumentosRetirados              PredioDocumento[]                      @relation("PredioDocumentoRetirador")
  predioDatosFuenteDecididos             PredioDatoFuente[]                     @relation("PredioDatoFuenteDecisor")
  expedientesGestor                      Expediente[]                           @relation("ExpedienteGestor")
  flujoVersionesCreadas                  FlujoVersion[]                         @relation("FlujoVersionCreador")
  formularioVersionesCreadas             FormularioVersion[]                    @relation("FormularioVersionCreador")
  honorariosReconocidos                  HonorarioGenerado[]                    @relation("HonorarioGeneradoActor")
  honorariosResponsable                  HonorarioGenerado[]                    @relation("HonorarioGeneradoResponsable")
  metasHonorarioCreadas                  MetaHonorario[]                        @relation("MetaHonorarioCreador")
  metasHonorario                         MetaHonorario[]                        @relation("MetaHonorarioUsuario")
  movimientoVinculosCreados              MovimientoDocumento[]                  @relation("MovimientoDocCreador")
  movimientosAplicados                   MovimientoFinanciero[]                 @relation("MovimientoAplicado")
  movimientosCancelados                  MovimientoFinanciero[]                 @relation("MovimientoCancelado")
  movimientosCapturados                  MovimientoFinanciero[]                 @relation("MovimientoCapturado")
  movimientosResponsable                 MovimientoFinanciero[]                 @relation("MovimientoResponsable")
  movimientosRevertidos                  MovimientoFinanciero[]                 @relation("MovimientoRevertido")
  movimientosValidados                   MovimientoFinanciero[]                 @relation("MovimientoValidado")
  notas                                  Nota[]
  notificationsCreated                   Notification[]                         @relation("NotificationCreator")
  notifications                          Notification[]                         @relation("NotificationRecipient")
  passwordResetTokens                    PasswordResetToken[]
  instrumentosMoralCreados               PersonaMoralInstrumento[]              @relation("InstrumentoCreador")
  instrumentosMoralValidados             PersonaMoralInstrumento[]              @relation("InstrumentoValidador")
  representantesCorporativosCreados      PersonaMoralRepresentante[]            @relation("RepresentanteCorporativoCreador")
  plantillaDocVersionesCreadas           PlantillaDocumentalVersion[]           @relation("PlantillaDocumentalVersionCreador")
  prospectoVinculosCreados               ProspectoDocumento[]                   @relation("ProspectoDocCreador")
  seguimientosProspectos                 ProspectoSeguimiento[]
  archivedProspectos                     Prospecto[]                            @relation("ProspectoArchivedBy")
  prospectos                             Prospecto[]
  requisitoVinculosCreados               RequisitoDocumentoVinculo[]            @relation("RequisitoDocCreador")
  tareasAsignadas                        Tarea[]                                @relation("TareaAsignado")
  tareasCreadas                          Tarea[]                                @relation("TareaCreador")
  tramitesPostfirmaGestionados           TareaExterna[]                         @relation("TareaExternaGestor")
  transaccionesBancoImportadas           TransaccionEstadoCuenta[]              @relation("TransaccionBancoImportador")
  invitationsAccepted                    UserInvitation[]                       @relation("InvitationAcceptedUser")
  invitationsCreated                     UserInvitation[]                       @relation("InvitationCreator")
  calculosISRCreados                     CalculoISR[]                           @relation("CalculoISRCreador")
  calculosISRActualizados                CalculoISR[]                           @relation("CalculoISRActualizador")
  calculosISRVersiones                   CalculoISRVersion[]                    @relation("CalculoISRVersionActor")
  calculosISRDocumentos                  CalculoISRDocumento[]                  @relation("CalculoISRDocumentoActor")
  calculosISRPropuestasRevisadas         CalculoISRPropuesta[]                  @relation("CalculoISRPropuestaRevisor")
  catalogoNormativaRevisionesCreadas     CatalogoNormativaRevision[]            @relation("CatalogoNormativaRevisionCreator")
  catalogoBibliotecaImportacionesCreadas CatalogoBibliotecaImportacion[]        @relation("CatalogoBibliotecaImportacionCreator")
  preference                             UserPreference?
  organizationMemberships                OrganizationMembership[]

  @@map("users")
}

model AuthSession {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String                  @db.Uuid
  organization_id    String?                 @db.Uuid
  membership_id      String?                 @db.Uuid
  refresh_token_hash String                  @unique
  user_agent         String?
  ip_address         String?
  expires_at         DateTime
  last_used_at       DateTime                @default(now())
  revoked_at         DateTime?
  revoked_reason     String?
  rotated_from_id    String?                 @db.Uuid
  created_at         DateTime                @default(now())
  persistent         Boolean                 @default(false)
  user               User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization       Organization?           @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  membership         OrganizationMembership? @relation(fields: [membership_id], references: [id], onDelete: Restrict)

  @@index([user_id, revoked_at, expires_at], map: "auth_sessions_user_revoked_expires_idx")
  @@index([organization_id, revoked_at, expires_at], map: "auth_sessions_org_revoked_expires_idx")
  @@index([membership_id], map: "idx_auth_sessions_membership_fk")
  @@map("auth_sessions")
}

model PasswordResetToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  token_hash   String    @unique
  expires_at   DateTime
  used_at      DateTime?
  requested_ip String?
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, used_at, expires_at], map: "password_reset_tokens_user_used_expires_idx")
  @@map("password_reset_tokens")
}

model UserPreference {
  id                            String   @id @default(uuid()) @db.Uuid
  user_id                       String   @unique @db.Uuid
  default_view                  String   @default("CARDS")
  density                       String   @default("COMFORTABLE")
  timezone                      String   @default("America/Mexico_City")
  date_format                   String   @default("DD/MM/YYYY")
  theme                         String   @default("SYSTEM")
  notifications_enabled         Boolean  @default(true)
  assistant_suggestions_enabled Boolean  @default(true)
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt
  user                          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserInvitation {
  id               String    @id @default(uuid()) @db.Uuid
  organization_id  String?   @db.Uuid
  email            String
  nombre           String
  apellido         String
  rol              Role
  token_hash       String    @unique
  expires_at       DateTime
  accepted_at      DateTime?
  revoked_at       DateTime?
  created_by_id    String    @db.Uuid
  accepted_user_id String?   @db.Uuid
  created_at       DateTime  @default(now())
  accepted_user    User?     @relation("InvitationAcceptedUser", fields: [accepted_user_id], references: [id])
  created_by       User      @relation("InvitationCreator", fields: [created_by_id], references: [id])

  @@unique([organization_id, accepted_user_id], map: "user_invitations_org_accepted_user_key")
  @@index([email, accepted_at, revoked_at, expires_at])
  @@index([created_by_id], map: "idx_user_invitations_created_by_fk")
  @@map("user_invitations")
}

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String?   @db.Uuid
  recipient_id    String    @db.Uuid
  created_by_id   String?   @db.Uuid
  type            String
  title           String
  body            String
  href            String?
  read_at         DateTime?
  created_at      DateTime  @default(now())
  created_by      User?     @relation("NotificationCreator", fields: [created_by_id], references: [id])
  recipient       User      @relation("NotificationRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([recipient_id, read_at, created_at])
  @@index([created_by_id], map: "idx_notifications_created_by_fk")
  @@map("notifications")
}

model Prospecto {
  id                           String                     @id @default(uuid()) @db.Uuid
  organization_id              String?                    @db.Uuid
  nombre                       String
  telefono                     String?
  email                        String?
  tipo_acto                    String?
  necesidad                    String?
  documentos_disponibles       String?
  tiene_antecedente            Boolean?
  tiene_predial                Boolean?
  honorarios_estimados         Decimal?                   @db.Decimal(14, 2)
  impuestos_derechos_estimados Decimal?                   @db.Decimal(14, 2)
  total_estimado               Decimal?                   @db.Decimal(14, 2)
  puede_compartir_docs         Boolean?
  tiempo_estimado              String?
  estado                       ProspectoEstado            @default(NUEVO)
  user_id                      String                     @db.Uuid
  created_at                   DateTime                   @default(now())
  updated_at                   DateTime                   @updatedAt
  archived_at                  DateTime?
  archived_by                  String?                    @db.Uuid
  ciudad                       String?
  fuente                       String?
  motivo_archivo               String?
  prioridad                    ProspectoPrioridad         @default(MEDIA)
  etapa_operativa_codigo       String?
  servicio_catalogo_codigo     String?
  folio                        String?                    @unique
  notaria_id                   String?                    @db.Uuid
  etapa_contractual            ProspectoEtapaContractual?
  version_operativa            Int                        @default(0)
  transicion_actual_id         String?                    @db.Uuid
  creation_key                 String?                    @db.VarChar(120)
  creation_hash                String?                    @db.VarChar(64)
  notaria                      Notaria?                   @relation(fields: [notaria_id], references: [id], onDelete: Restrict)
  transicion_actual            ProspectoTransicion?       @relation("ProspectoCurrentTransition", fields: [transicion_actual_id], references: [id], onDelete: Restrict)
  transiciones                 ProspectoTransicion[]      @relation("ProspectoTransitions")
  fuentes_notariales           ProspectoFuenteNotarial[]
  cotizacion                   Cotizacion?
  documentos                   Documento[]
  prospectoDocumentos          ProspectoDocumento[]
  seguimientos                 ProspectoSeguimiento[]
  archived_by_user             User?                      @relation("ProspectoArchivedBy", fields: [archived_by], references: [id])
  atendido_por                 User                       @relation(fields: [user_id], references: [id])
  etapa_operativa              ProspectoEtapaCatalogo?    @relation(fields: [etapa_operativa_codigo], references: [codigo])
  servicio_catalogo            ProspectoServicioCatalogo? @relation(fields: [servicio_catalogo_codigo], references: [codigo])

  @@unique([organization_id, creation_key], map: "uq_prospecto_creation_key")
  @@index([archived_by], map: "idx_prospectos_archivado_por_fk")
  @@index([user_id], map: "idx_prospectos_user_fk")
  @@index([etapa_operativa_codigo], map: "idx_prospectos_etapa_operativa_fk")
  @@index([servicio_catalogo_codigo], map: "idx_prospectos_servicio_catalogo_fk")
  @@index([notaria_id, organization_id], map: "idx_prospecto_notaria_org")
  @@index([transicion_actual_id], map: "idx_prospecto_current_transition")
  @@index([organization_id, etapa_contractual], map: "idx_prospecto_contract_stage")
  @@map("prospectos")
}

enum ProspectoEtapaContractual {
  NUEVO
  EN_INTEGRACION
  LISTO_PARA_COTIZAR
  CONVERTIDO_EN_COTIZACION
  SUSPENDIDO
  CANCELADO
  RECABANDO_INFORMACION
  LISTO_PARA_SOLICITAR
  SOLICITUD_ENVIADA_NOTARIA
  EN_ESPERA_COTIZACION
  COTIZACION_RECIBIDA
  CONVERTIDO_COTIZACION
}

// Hechos de negocio append-only, no notas libres ni AuditLog técnico.
model ProspectoTransicion {
  id              String                     @id @default(uuid()) @db.Uuid
  organization_id String                     @db.Uuid
  prospecto_id    String                     @db.Uuid
  actor_id        String                     @db.Uuid
  etapa_anterior  ProspectoEtapaContractual?
  etapa_nueva     ProspectoEtapaContractual
  hito_intermedio ProspectoEtapaContractual?
  effective_at    DateTime
  recorded_at     DateTime                   @default(now())
  accion          String                     @db.VarChar(60)
  procedencia     String                     @db.VarChar(60)
  evidencia       Json
  version         Int
  idempotency_key String                     @db.VarChar(120)
  payload_hash    String                     @db.VarChar(64)
  organization    Organization               @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  prospecto       Prospecto                  @relation("ProspectoTransitions", fields: [prospecto_id], references: [id], onDelete: Restrict)
  actor           OrganizationMembership     @relation(fields: [organization_id, actor_id], references: [organization_id, user_id], onDelete: Restrict)
  actual_para     Prospecto[]                @relation("ProspectoCurrentTransition")

  @@unique([organization_id, prospecto_id, idempotency_key], map: "uq_prospecto_transition_key")
  @@unique([prospecto_id, version], map: "uq_prospecto_transition_version")
  @@index([organization_id, actor_id], map: "idx_prospecto_transition_actor")
  @@index([prospecto_id, organization_id, effective_at], map: "idx_prospecto_transition_history")
  @@map("prospecto_transiciones")
}

// Versiones de una fuente: referencia al mismo sistema documental, no otro almacén.
model ProspectoFuenteNotarial {
  id              String                   @id @default(uuid()) @db.Uuid
  organization_id String                   @db.Uuid
  prospecto_id    String                   @db.Uuid
  documento_id    String                   @db.Uuid
  notaria_id      String                   @db.Uuid
  actor_id        String                   @db.Uuid
  version         Int
  received_at     DateTime
  recorded_at     DateTime                 @default(now())
  origen          String                   @db.VarChar(60)
  motivo          String
  sustituye_id    String?                  @unique @db.Uuid
  idempotency_key String                   @db.VarChar(120)
  payload_hash    String                   @db.VarChar(64)
  organization    Organization             @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  prospecto       Prospecto                @relation(fields: [prospecto_id], references: [id], onDelete: Restrict)
  documento       Documento                @relation(fields: [documento_id], references: [id], onDelete: Restrict)
  notaria         Notaria                  @relation(fields: [notaria_id], references: [id], onDelete: Restrict)
  actor           OrganizationMembership   @relation(fields: [organization_id, actor_id], references: [organization_id, user_id], onDelete: Restrict)
  sustituye       ProspectoFuenteNotarial? @relation("NotarySourceVersions", fields: [sustituye_id], references: [id], onDelete: Restrict)
  sustituida_por  ProspectoFuenteNotarial? @relation("NotarySourceVersions")
  cotizaciones    Cotizacion[]

  @@unique([organization_id, prospecto_id, idempotency_key], map: "uq_prospecto_source_key")
  @@unique([prospecto_id, version], map: "uq_prospecto_source_version")
  @@unique([prospecto_id, documento_id], map: "uq_prospecto_source_document")
  @@index([organization_id, actor_id], map: "idx_prospecto_source_actor")
  @@index([documento_id, organization_id], map: "idx_prospecto_source_document")
  @@index([notaria_id, organization_id], map: "idx_prospecto_source_notary")
  @@map("prospecto_fuentes_notariales")
}

model ProspectoEtapaCatalogo {
  codigo     String      @id
