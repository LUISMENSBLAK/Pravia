/// Los hechos variables permanecen declarativos; Cumplimiento conserva la autoridad
/// sobre BC, riesgo, PEP y perfil transaccional.
model CatalogoNormativaRevision {
  id                     String                         @id @default(uuid()) @db.Uuid
  organization_id        String                         @db.Uuid
  artefacto_id           String                         @db.Uuid
  codigo_revision        String                         @db.VarChar(160)
  revision               Int
  fundamento_normativo   String
  version_normativa      String                         @db.VarChar(160)
