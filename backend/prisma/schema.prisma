generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                     String                        @id @default(uuid()) @db.Uuid
  email                                  String                        @unique
  password_hash                          String
  nombre                                 String
  apellido                               String
  rol                                    Role                          @default(ABOGADO)
  avatar_url                             String?
  activo                                 Boolean                       @default(true)
  created_at                             DateTime                      @default(now())
  updated_at                             DateTime                      @updatedAt
  password_changed_at                    DateTime?
  failed_login_attempts                  Int                           @default(0)
  locked_until                           DateTime?
  last_login_at                          DateTime?
  requires_password_change               Boolean                       @default(true)
  telefono                               String?
  aiUsageLogs                            AIUsageLog[]
  auditLogs                              AuditLog[]
  authSessions                           AuthSession[]
  cargasTemporales                       CargaTemporalDocumento[]      @relation("CargaTemporalUsuario")
  comparecienteAltaSessions              ComparecienteAltaSession[]    @relation("ComparecienteAltaSessionUsuario")
  contactosComparecienteCreados          ComparecienteContacto[]       @relation("ContactoCreador")
  datosFuenteConfirmados                 ComparecienteDatoFuente[]     @relation("DatoFuenteConfirmador")
  comparecienteVinculosCreados           ComparecienteDocumento[]      @relation("ComparecienteDocCreador")
  comparecienteDocsValidados             ComparecienteDocumento[]      @relation("ComparecienteDocValidador")
  domiciliosComparecienteCreados         ComparecienteDomicilio[]      @relation("DomicilioCreador")
  identificacionesComparecienteCreadas   ComparecienteIdentificacion[] @relation("IdentificacionCreador")
  identificacionesComparecienteValidadas ComparecienteIdentificacion[] @relation("IdentificacionValidador")
  comparecientesCreados                  Compareciente[]               @relation("ComparecienteCreador")
  complianceDecisions                    ComplianceDecision[]          @relation("ComplianceDecisionActor")
  complianceEvidenceAdded                ComplianceEvidence[]          @relation("ComplianceEvidenceAdder")
  complianceReviewsCreated               ComplianceReview[]            @relation("ComplianceReviewCreator")
  complianceReviewsReviewed              ComplianceReview[]            @relation("ComplianceReviewReviewer")
  complianceRulesApproved                ComplianceRuleSet[]           @relation("ComplianceRuleApprover")
  complianceRulesCreated                 ComplianceRuleSet[]           @relation("ComplianceRuleCreator")
  comprobantesAnulados                   ComprobanteFinanciero[]       @relation("ComprobanteAnulador")
  comprobantesRegistrados                ComprobanteFinanciero[]       @relation("ComprobanteRegistrador")
  comunicacionVinculosCreados            ComunicacionDocumento[]       @relation("ComunicacionDocCreador")
  comunicaciones                         Comunicacion[]
  conciliacionesRegistradas              ConciliacionFinanciera[]      @relation("ConciliacionActor")
  cotizacionVinculosCreados              CotizacionDocumento[]         @relation("CotizacionDocCreador")
  seguimientosCotizaciones               CotizacionSeguimiento[]
  cotizaciones                           Cotizacion[]
  cuentasFinancierasCreadas              CuentaFinanciera[]            @relation("CuentaFinancieraCreador")
  documentosSubidos                      Documento[]
  outboxEventosDisparados                DomainEventOutbox[]           @relation("OutboxActor")
  eventosCancelados                      EventoAgenda[]                @relation("EventoCanceladoPor")
  eventos                                EventoAgenda[]                @relation("EventoResponsable")
  expedienteActividades                  ExpedienteActividad[]
  expedienteComparecientesCreados        ExpedienteCompareciente[]     @relation("ExpedienteComparecienteCreador")
  expedienteComparecientesValidados      ExpedienteCompareciente[]     @relation("ExpedienteComparecienteValidador")
  expedienteVinculosCreados              ExpedienteDocumento[]         @relation("ExpedienteDocCreador")
  entregasRegistradas                    ExpedienteEntrega[]           @relation("ExpedienteEntregaRegistrador")
  expedienteRepresentacionesCreadas      ExpedienteRepresentacion[]    @relation("ExpedienteRepresentacionCreador")
  expedienteRepresentacionesValidadas    ExpedienteRepresentacion[]    @relation("ExpedienteRepresentacionValidador")
  expedientes                            Expediente[]                  @relation("ExpedienteAbogado")
  expedientesArchivados                  Expediente[]                  @relation("ExpedienteArchivedBy")
  expedientesCreados                     Expediente[]                  @relation("ExpedienteCreador")
  expedientesGestor                      Expediente[]                  @relation("ExpedienteGestor")
  flujoVersionesCreadas                  FlujoVersion[]                @relation("FlujoVersionCreador")
  formularioVersionesCreadas             FormularioVersion[]           @relation("FormularioVersionCreador")
  honorariosReconocidos                  HonorarioGenerado[]           @relation("HonorarioGeneradoActor")
  honorariosResponsable                  HonorarioGenerado[]           @relation("HonorarioGeneradoResponsable")
  metasHonorarioCreadas                  MetaHonorario[]               @relation("MetaHonorarioCreador")
  metasHonorario                         MetaHonorario[]               @relation("MetaHonorarioUsuario")
  movimientoVinculosCreados              MovimientoDocumento[]         @relation("MovimientoDocCreador")
  movimientosAplicados                   MovimientoFinanciero[]        @relation("MovimientoAplicado")
  movimientosCancelados                  MovimientoFinanciero[]        @relation("MovimientoCancelado")
  movimientosCapturados                  MovimientoFinanciero[]        @relation("MovimientoCapturado")
  movimientosResponsable                 MovimientoFinanciero[]        @relation("MovimientoResponsable")
  movimientosRevertidos                  MovimientoFinanciero[]        @relation("MovimientoRevertido")
  movimientosValidados                   MovimientoFinanciero[]        @relation("MovimientoValidado")
  notas                                  Nota[]
  notificationsCreated                   Notification[]                @relation("NotificationCreator")
  notifications                          Notification[]                @relation("NotificationRecipient")
  passwordResetTokens                    PasswordResetToken[]
  instrumentosMoralCreados               PersonaMoralInstrumento[]     @relation("InstrumentoCreador")
  instrumentosMoralValidados             PersonaMoralInstrumento[]     @relation("InstrumentoValidador")
  representantesCorporativosCreados      PersonaMoralRepresentante[]   @relation("RepresentanteCorporativoCreador")
  plantillaDocVersionesCreadas           PlantillaDocumentalVersion[]  @relation("PlantillaDocumentalVersionCreador")
  prospectoVinculosCreados               ProspectoDocumento[]          @relation("ProspectoDocCreador")
  seguimientosProspectos                 ProspectoSeguimiento[]
  archivedProspectos                     Prospecto[]                   @relation("ProspectoArchivedBy")
  prospectos                             Prospecto[]
  requisitoVinculosCreados               RequisitoDocumentoVinculo[]   @relation("RequisitoDocCreador")
  tareasAsignadas                        Tarea[]                       @relation("TareaAsignado")
  tareasCreadas                          Tarea[]                       @relation("TareaCreador")
  tramitesPostfirmaGestionados           TareaExterna[]                @relation("TareaExternaGestor")
  transaccionesBancoImportadas           TransaccionEstadoCuenta[]     @relation("TransaccionBancoImportador")
  invitationAccepted                     UserInvitation?               @relation("InvitationAcceptedUser")
  invitationsCreated                     UserInvitation[]              @relation("InvitationCreator")
  preference                             UserPreference?

  @@map("users")
}

model AuthSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @unique
  user_agent         String?
  ip_address         String?
  expires_at         DateTime
  last_used_at       DateTime  @default(now())
  revoked_at         DateTime?
  revoked_reason     String?
  rotated_from_id    String?   @db.Uuid
  created_at         DateTime  @default(now())
  persistent         Boolean   @default(false)
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at, expires_at], map: "auth_sessions_user_revoked_expires_idx")
  @@map("auth_sessions")
}

model PasswordResetToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  token_hash   String    @unique
  expires_at   DateTime
  used_at      DateTime?
  requested_ip String?
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, used_at, expires_at], map: "password_reset_tokens_user_used_expires_idx")
  @@map("password_reset_tokens")
}

model UserPreference {
  id                            String   @id @default(uuid()) @db.Uuid
  user_id                       String   @unique @db.Uuid
  default_view                  String   @default("CARDS")
  density                       String   @default("COMFORTABLE")
  timezone                      String   @default("America/Mexico_City")
  date_format                   String   @default("DD/MM/YYYY")
  theme                         String   @default("SYSTEM")
  notifications_enabled         Boolean  @default(true)
  assistant_suggestions_enabled Boolean  @default(true)
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt
  user                          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserInvitation {
  id               String    @id @default(uuid()) @db.Uuid
  email            String
  nombre           String
  apellido         String
  rol              Role
  token_hash       String    @unique
  expires_at       DateTime
  accepted_at      DateTime?
  revoked_at       DateTime?
  created_by_id    String    @db.Uuid
  accepted_user_id String?   @unique @db.Uuid
  created_at       DateTime  @default(now())
  accepted_user    User?     @relation("InvitationAcceptedUser", fields: [accepted_user_id], references: [id])
  created_by       User      @relation("InvitationCreator", fields: [created_by_id], references: [id])

  @@index([email, accepted_at, revoked_at, expires_at])
  @@index([created_by_id], map: "idx_user_invitations_created_by_fk")
  @@map("user_invitations")
}

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  recipient_id  String    @db.Uuid
  created_by_id String?   @db.Uuid
  type          String
  title         String
  body          String
  href          String?
  read_at       DateTime?
  created_at    DateTime  @default(now())
  created_by    User?     @relation("NotificationCreator", fields: [created_by_id], references: [id])
  recipient     User      @relation("NotificationRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([recipient_id, read_at, created_at])
  @@index([created_by_id], map: "idx_notifications_created_by_fk")
  @@map("notifications")
}

model Prospecto {
  id                       String                     @id @default(uuid()) @db.Uuid
  nombre                   String
  telefono                 String?
  email                    String?
  tipo_acto                String?
  necesidad                String?
  documentos_disponibles   String?
  tiene_antecedente        Boolean?
  tiene_predial            Boolean?
  puede_compartir_docs     Boolean?
  tiempo_estimado          String?
  estado                   ProspectoEstado            @default(NUEVO)
  user_id                  String                     @db.Uuid
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @updatedAt
  archived_at              DateTime?
  archived_by              String?                    @db.Uuid
  ciudad                   String?
  fuente                   String?
  motivo_archivo           String?
  prioridad                ProspectoPrioridad         @default(MEDIA)
  etapa_operativa_codigo   String?
  servicio_catalogo_codigo String?
  cotizacion               Cotizacion?
  documentos               Documento[]
  prospectoDocumentos      ProspectoDocumento[]
  seguimientos             ProspectoSeguimiento[]
  archived_by_user         User?                      @relation("ProspectoArchivedBy", fields: [archived_by], references: [id])
  atendido_por             User                       @relation(fields: [user_id], references: [id])
  etapa_operativa          ProspectoEtapaCatalogo?    @relation(fields: [etapa_operativa_codigo], references: [codigo])
  servicio_catalogo        ProspectoServicioCatalogo? @relation(fields: [servicio_catalogo_codigo], references: [codigo])

  @@index([archived_by], map: "idx_prospectos_archivado_por_fk")
  @@index([user_id], map: "idx_prospectos_user_fk")
  @@index([etapa_operativa_codigo], map: "idx_prospectos_etapa_operativa_fk")
  @@index([servicio_catalogo_codigo], map: "idx_prospectos_servicio_catalogo_fk")
  @@map("prospectos")
}

model ProspectoEtapaCatalogo {
  codigo     String      @id
  label      String      @unique
  orden      Int         @unique
  activo     Boolean     @default(true)
  prospectos Prospecto[]

  @@map("prospecto_etapas_catalogo")
}

model ProspectoServicioCatalogo {
  codigo        String      @id
  label         String      @unique
  orden         Int         @unique
  activo        Boolean     @default(true)
  estados       String[]
  tipos_persona String[]
  prospectos    Prospecto[]

  @@map("prospecto_servicios_catalogo")
}

model ProspectoSeguimiento {
  id                        String    @id @default(uuid()) @db.Uuid
  prospecto_id              String    @db.Uuid
  tipo                      String
  contenido                 String
  created_at                DateTime  @default(now())
  fecha_proximo_seguimiento DateTime?
  proxima_accion            String?
  usuario_id                String    @db.Uuid
  prospecto                 Prospecto @relation(fields: [prospecto_id], references: [id], onDelete: Cascade)
  usuario                   User      @relation(fields: [usuario_id], references: [id])

  @@index([prospecto_id], map: "idx_pros_seguimientos_prospecto_fk")
  @@index([usuario_id], map: "idx_pros_seguimientos_usuario_fk")
  @@map("prospecto_seguimientos")
}

model Notaria {
  id                        String                       @id @default(uuid()) @db.Uuid
  nombre                    String
  ciudad                    String?
  contacto_principal        String?
  dias_respuesta_estimados  Int                          @default(5)
  requisitos_frecuentes     String?
  created_at                DateTime                     @default(now())
  updated_at                DateTime                     @updatedAt
  activa                    Boolean                      @default(true)
  archived_at               DateTime?
  codigo_postal             String?
  color_identificador       String?                      @default("#D4AF37")
  correo_general            String?
  correo_proyectos          String?
  demarcacion               String?
  dias_atencion             String?
  direccion                 String?
  entidad_federativa        String                       @default("Nayarit")
  horario                   String?
  instituciones_json        Json?
  instrucciones_especiales  String?
  municipio                 String                       @default("Tepic")
  municipios_atendidos_json Json?
  notario_titular           String?
  numero_notaria            String?
  observaciones_generales   String?
  pagina_web                String?
  predeterminada            Boolean                      @default(false)
  telefono                  String?
  tiempo_firma              String?
  tiempo_presupuesto        String?
  tiempo_respuesta          String?
  tipos_acto_json           Json?
  whatsapp                  String?
  cotizaciones              Cotizacion[]
  expedientes               Expediente[]
  honorariosGenerados       HonorarioGenerado[]
  movimientosFinancieros    MovimientoFinanciero[]
  contactos                 NotariaContacto[]
  plantillaDocumentales     PlantillaDocumentalVersion[]

  @@map("notarias")
}

model NotariaContacto {
  id            String   @id @default(uuid()) @db.Uuid
  notaria_id    String   @db.Uuid
  nombre        String
  cargo         String
  telefono      String?
  whatsapp      String?
  correo        String?
  observaciones String?
  activo        Boolean  @default(true)
  created_at    DateTime @default(now())
  notaria       Notaria  @relation(fields: [notaria_id], references: [id], onDelete: Cascade)

  @@index([notaria_id], map: "idx_notaria_contactos_notaria_fk")
  @@map("notaria_contactos")
}

model Cotizacion {
  id                             String                  @id @default(uuid()) @db.Uuid
  prospecto_id                   String?                 @unique @db.Uuid
  user_id                        String                  @db.Uuid
  estado                         CotizacionEstado        @default(BORRADOR)
  created_at                     DateTime                @default(now())
  updated_at                     DateTime                @default(now()) @updatedAt
  cuerpo_correo_cliente          String?
  cuerpo_correo_notaria          String?
  fecha_aceptacion_cliente       DateTime?
  fecha_enviada_cliente          DateTime?
  fecha_limite_respuesta_notaria DateTime?
  fecha_presupuesto_recibido     DateTime?
  fecha_solicitud_notaria        DateTime?
  honorarios_pravia              Decimal?                @db.Decimal(14, 2)
  notaria_id                     String?                 @db.Uuid
  numero_cotizacion              String?                 @unique
  numero_solicitud               String?                 @unique
  total_cliente                  Decimal?                @db.Decimal(14, 2)
  total_notaria                  Decimal?                @db.Decimal(14, 2)
  version_actual                 Int                     @default(1)
  fecha_aprobacion_version       DateTime?
  fecha_conversion_expediente    DateTime?
  cotizacionDocumentos           CotizacionDocumento[]
  seguimientos                   CotizacionSeguimiento[]
  versiones                      CotizacionVersion[]
  notaria                        Notaria?                @relation(fields: [notaria_id], references: [id])
  prospecto                      Prospecto?              @relation(fields: [prospecto_id], references: [id])
  creada_por                     User                    @relation(fields: [user_id], references: [id])
  documentos                     Documento[]
  expediente                     Expediente?
  honorariosGenerados            HonorarioGenerado?
  movimientosFinancieros         MovimientoFinanciero[]
  pagos                          Pago[]

  @@index([notaria_id], map: "idx_cotizaciones_notaria_fk")
  @@index([user_id], map: "idx_cotizaciones_user_fk")
  @@map("cotizaciones")
}

model CotizacionVersion {
  id                  String              @id @default(uuid()) @db.Uuid
  cotizacion_id       String              @db.Uuid
  version             Int
  total_cliente       Decimal             @db.Decimal(14, 2)
  notas               String?
  pdf_url             String?
  created_at          DateTime            @default(now())
  creada_por_id       String?             @db.Uuid
  desglose_notaria    Json?
  desglose_pravia     Json?
  honorarios_pravia   Decimal             @db.Decimal(14, 2)
  montos_extraidos_ia Json?
  total_notaria       Decimal             @db.Decimal(14, 2)
  aprobada            Boolean             @default(false)
  cotizacion          Cotizacion          @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade)
  honorariosGenerados HonorarioGenerado[]

  @@unique([cotizacion_id, version])
  @@map("cotizacion_versiones")
}

model CotizacionSeguimiento {
  id                        String     @id @default(uuid()) @db.Uuid
  cotizacion_id             String     @db.Uuid
  usuario_id                String     @db.Uuid
  tipo                      String
  destinatario              String
  resumen                   String
  resultado                 String?
  proxima_accion            String?
  responsable               String?
  fecha_proximo_seguimiento DateTime?
  created_at                DateTime   @default(now())
  cotizacion                Cotizacion @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade)
  usuario                   User       @relation(fields: [usuario_id], references: [id])

  @@index([cotizacion_id], map: "idx_cot_seguimientos_cotizacion_fk")
  @@index([usuario_id], map: "idx_cot_seguimientos_usuario_fk")
  @@map("cotizacion_seguimientos")
}

model TipoActo {
  id                              String                          @id @default(uuid()) @db.Uuid
  nombre                          String
  descripcion                     String?
  machote_referencia              String?
  activo                          Boolean                         @default(true)
  archived_at                     DateTime?
  created_at                      DateTime                        @default(now())
  updated_at                      DateTime                        @default(now()) @updatedAt
  checklist                       ChecklistItem[]
  expedientes                     Expediente[]
  flujoEtapas                     FlujoEtapa[]
  flujoVersiones                  FlujoVersion[]
  formularioSecciones             FormularioSeccion[]
  formularioVersiones             FormularioVersion[]
  plantillaDocVersiones           PlantillaDocumentalVersion[]
  tipoActoCaracteresCompareciente TipoActoCaracterCompareciente[]

  @@map("tipos_acto")
}

model FormularioSeccion {
  id           String            @id @default(uuid()) @db.Uuid
  tipo_acto_id String            @db.Uuid
  clave        String
  titulo       String
  orden        Int               @default(0)
  descripcion  String?
  campos       FormularioCampo[]
  tipo_acto    TipoActo          @relation(fields: [tipo_acto_id], references: [id])

  @@unique([tipo_acto_id, clave])
  @@map("formulario_secciones")
}

model FormularioCampo {
  id                         String            @id @default(uuid()) @db.Uuid
  seccion_id                 String            @db.Uuid
  clave_tecnica              String
  etiqueta                   String
  tipo_dato                  String
  orden                      Int               @default(0)
  obligatorio                Boolean           @default(false)
  valor_predeterminado       String?
  opciones_json              Json?
  validaciones_json          Json?
  condicion_visibilidad_json Json?
  texto_ayuda                String?
  activo                     Boolean           @default(true)
  seccion                    FormularioSeccion @relation(fields: [seccion_id], references: [id], onDelete: Cascade)

  @@unique([seccion_id, clave_tecnica])
  @@map("formulario_campos")
}

model FlujoEtapa {
  id                         String            @id @default(uuid()) @db.Uuid
  tipo_acto_id               String            @db.Uuid
  clave                      String
  nombre                     String
  orden                      Int               @default(1)
  obligatoria                Boolean           @default(true)
  se_puede_omitir            Boolean           @default(false)
  duracion_esperada_dias     Int               @default(3)
  estado_general_relacionado String
  etapa_siguiente_id         String?           @db.Uuid
  reglas_entrada_json        Json?
  reglas_salida_json         Json?
  activa                     Boolean           @default(true)
  expedienteEtapas           ExpedienteEtapa[]
  tipo_acto                  TipoActo          @relation(fields: [tipo_acto_id], references: [id])

  @@unique([tipo_acto_id, clave])
  @@map("flujo_etapas")
}

model FormularioVersion {
  id             String       @id @default(uuid()) @db.Uuid
  tipo_acto_id   String       @db.Uuid
  version        Int          @default(1)
  secciones_json Json
  campos_json    Json
  vigente_desde  DateTime     @default(now())
  creado_por_id  String       @db.Uuid
  expedientes    Expediente[]
  creado_por     User         @relation("FormularioVersionCreador", fields: [creado_por_id], references: [id])
  tipo_acto      TipoActo     @relation(fields: [tipo_acto_id], references: [id])

  @@unique([tipo_acto_id, version])
  @@index([creado_por_id], map: "idx_formulario_versiones_creador_fk")
  @@map("formulario_versiones")
}

model FlujoVersion {
  id                 String            @id @default(uuid()) @db.Uuid
  tipo_acto_id       String            @db.Uuid
  version            Int               @default(1)
  etapas_json        Json
  ponderaciones_json Json?
  vigente_desde      DateTime          @default(now())
  creado_por_id      String            @db.Uuid
  expedienteEtapas   ExpedienteEtapa[]
  expedientes        Expediente[]
  creado_por         User              @relation("FlujoVersionCreador", fields: [creado_por_id], references: [id])
  tipo_acto          TipoActo          @relation(fields: [tipo_acto_id], references: [id])

  @@unique([tipo_acto_id, version])
  @@index([creado_por_id], map: "idx_flujo_versiones_creador_fk")
  @@map("flujo_versiones")
}

model PlantillaDocumentalVersion {
  id              String       @id @default(uuid()) @db.Uuid
  tipo_acto_id    String       @db.Uuid
  version         Int          @default(1)
  requisitos_json Json
  vigente_desde   DateTime     @default(now())
  creado_por_id   String       @db.Uuid
  notaria_id      String?      @db.Uuid
  nombre          String?
  storage_key     String?
  mime_type       String?
  size_bytes      Int?
  checksum_sha256 String?
  activa          Boolean      @default(true)
  expedientes     Expediente[]
  creado_por      User         @relation("PlantillaDocumentalVersionCreador", fields: [creado_por_id], references: [id])
  notaria         Notaria?     @relation(fields: [notaria_id], references: [id])
  tipo_acto       TipoActo     @relation(fields: [tipo_acto_id], references: [id])

  @@unique([tipo_acto_id, notaria_id, version], map: "plantilla_documental_versiones_tipo_acto_id_notaria_id_version_")
  @@index([creado_por_id], map: "idx_plantilla_versiones_creador_fk")
  @@index([tipo_acto_id, notaria_id, activa], map: "plantilla_documental_versiones_tipo_acto_id_notaria_id_activa_i")
  @@map("plantilla_documental_versiones")
}

model ChecklistItem {
  id           String       @id @default(uuid()) @db.Uuid
  tipo_acto_id String       @db.Uuid
  nombre       String
  descripcion  String?
  categoria    DocCategoria @default(PROYECTO)
  obligatorio  Boolean      @default(true)
  orden        Int          @default(0)
  tipo_acto    TipoActo     @relation(fields: [tipo_acto_id], references: [id])

  @@index([tipo_acto_id], map: "idx_checklist_items_tipo_acto_fk")
  @@map("checklist_items")
}

model Expediente {
  id                         String                      @id @default(uuid()) @db.Uuid
  numero_pravia              String                      @unique
  numero_notaria             String?
  tipo_acto_id               String                      @db.Uuid
  abogado_id                 String                      @db.Uuid
  creador_id                 String                      @db.Uuid
  cotizacion_id              String?                     @unique @db.Uuid
  cliente_alias              String?
  fecha_apertura             DateTime                    @default(now())
  estatus                    ExpedienteEstatus           @default(ABIERTO)
  archived_at                DateTime?
  archived_by                String?                     @db.Uuid
  avance_documental          Int                         @default(0)
  avance_financiero          Int                         @default(0)
  avance_general             Int                         @default(0)
  avance_operativo           Int                         @default(0)
  created_at                 DateTime                    @default(now())
  datos_operacion            Json?
  descripcion                String?
  etapa_actual_nombre        String?                     @default("Apertura de Expediente")
  expediente_etapa_actual_id String?                     @unique @db.Uuid
  fecha_entrega_cliente      DateTime?
  fecha_estimada_firma       DateTime?
  fecha_limite_accion        DateTime?
  fecha_real_firma           DateTime?
  flujo_version_id           String?                     @db.Uuid
  formulario_version_id      String?                     @db.Uuid
  gestor_id                  String?                     @db.Uuid
  motivo_archivo             String?
  notaria_id                 String?                     @db.Uuid
  plantilla_doc_version_id   String?                     @db.Uuid
  proxima_accion             String?
  subtipo_acto               String?
  updated_at                 DateTime                    @default(now()) @updatedAt
  valor_operacion            Decimal?                    @db.Decimal(14, 2)
  version                    Int                         @default(1)
  aiUsageLogs                AIUsageLog[]
  comparecienteAltaSessions  ComparecienteAltaSession[]  @relation("ComparecienteAltaSessionOrigenExpediente")
  complianceReviews          ComplianceReview[]
  comunicaciones             Comunicacion[]
  documentos                 Documento[]
  eventos                    EventoAgenda[]
  actividades                ExpedienteActividad[]
  comparecientes             ExpedienteCompareciente[]
  expedienteDocumentos       ExpedienteDocumento[]
  entrega                    ExpedienteEntrega?
  estatus_logs               ExpedienteEstatus_Log[]
  etapas                     ExpedienteEtapa[]           @relation("ExpedienteEtapasLista")
  expedienteRepresentaciones ExpedienteRepresentacion[]
  requisitos_docs            ExpedienteRequisitoDoc[]
  abogado                    User                        @relation("ExpedienteAbogado", fields: [abogado_id], references: [id])
  archived_by_user           User?                       @relation("ExpedienteArchivedBy", fields: [archived_by], references: [id])
  cotizacion                 Cotizacion?                 @relation(fields: [cotizacion_id], references: [id], onDelete: Restrict)
  creador                    User                        @relation("ExpedienteCreador", fields: [creador_id], references: [id])
  etapaActual                ExpedienteEtapa?            @relation("ExpedienteEtapaActual", fields: [expediente_etapa_actual_id], references: [id])
  flujoVersion               FlujoVersion?               @relation(fields: [flujo_version_id], references: [id])
  formularioVersion          FormularioVersion?          @relation(fields: [formulario_version_id], references: [id])
  gestor                     User?                       @relation("ExpedienteGestor", fields: [gestor_id], references: [id])
  notaria                    Notaria?                    @relation(fields: [notaria_id], references: [id])
  plantillaDocVersion        PlantillaDocumentalVersion? @relation(fields: [plantilla_doc_version_id], references: [id])
  tipo_acto                  TipoActo                    @relation(fields: [tipo_acto_id], references: [id])
  honorariosGenerados        HonorarioGenerado[]
  movimientosFinancieros     MovimientoFinanciero[]
  pagos                      Pago[]
  tareas                     Tarea[]
  tareas_externas            TareaExterna[]

  @@index([abogado_id], map: "idx_expedientes_abogado_fk")
  @@index([archived_by], map: "idx_expedientes_archivado_por_fk")
  @@index([creador_id], map: "idx_expedientes_creador_fk")
  @@index([flujo_version_id], map: "idx_expedientes_flujo_version_fk")
  @@index([formulario_version_id], map: "idx_expedientes_formulario_version_fk")
  @@index([gestor_id], map: "idx_expedientes_gestor_fk")
  @@index([notaria_id], map: "idx_expedientes_notaria_fk")
  @@index([plantilla_doc_version_id], map: "idx_expedientes_plantilla_version_fk")
  @@index([tipo_acto_id], map: "idx_expedientes_tipo_acto_fk")
  @@map("expedientes")
}

model ExpedienteEstatus_Log {
  id               String             @id @default(uuid()) @db.Uuid
  expediente_id    String             @db.Uuid
  estatus_anterior ExpedienteEstatus?
  estatus_nuevo    ExpedienteEstatus
  user_id          String             @db.Uuid
  fecha            DateTime           @default(now())
  fecha_efectiva   DateTime?
  notas            String?
  expediente       Expediente         @relation(fields: [expediente_id], references: [id])

  @@index([expediente_id], map: "idx_exp_estatus_log_expediente_fk")
  @@map("expediente_estatus_log")
}

model ExpedienteEtapa {
  id                         String        @id @default(uuid()) @db.Uuid
  expediente_id              String        @db.Uuid
  flujo_etapa_id             String?       @db.Uuid
  flujo_version_id           String?       @db.Uuid
  clave_snapshot             String
  nombre_snapshot            String
  orden_snapshot             Int           @default(1)
  duracion_esperada_snapshot Int?
  fecha_inicio               DateTime      @default(now())
  fecha_fin                  DateTime?
  duracion_dias_naturales    Float?
  duracion_horas             Float?
  responsable_id             String?       @db.Uuid
  observaciones              String?
  evidencia_url              String?
  motivo_retraso             String?
  completada                 Boolean       @default(false)
  created_at                 DateTime      @default(now())
  expediente                 Expediente    @relation("ExpedienteEtapasLista", fields: [expediente_id], references: [id])
  flujoEtapa                 FlujoEtapa?   @relation(fields: [flujo_etapa_id], references: [id])
  flujoVersion               FlujoVersion? @relation(fields: [flujo_version_id], references: [id])
  expedienteActualRel        Expediente?   @relation("ExpedienteEtapaActual")

  @@index([expediente_id], map: "idx_exp_etapas_expediente_fk")
  @@index([flujo_etapa_id], map: "idx_exp_etapas_flujo_etapa_fk")
  @@index([flujo_version_id], map: "idx_exp_etapas_flujo_version_fk")
  @@map("expediente_etapas")
}

model Documento {
  id                           String                        @id @default(uuid()) @db.Uuid
  nombre_original              String
  nombre_interno               String                        @unique
  tipo                         String
  categoria                    DocCategoria                  @default(PROYECTO)
  storage_key                  String                        @unique
  mime_type                    String
  size_bytes                   Int
  fecha_carga                  DateTime                      @default(now())
  fecha_emision                DateTime?
  fecha_vigencia               DateTime?
  observaciones                String?
  datos_extraidos              Json?
  estatus                      DocEstatus                    @default(PENDIENTE)
  subido_por_id                String                        @db.Uuid
  prospecto_id                 String?                       @db.Uuid
  cotizacion_id                String?                       @db.Uuid
  expediente_id                String?                       @db.Uuid
  compareciente_id             String?                       @db.Uuid
  datosFuente                  ComparecienteDatoFuente[]
  comparecienteVinculos        ComparecienteDocumento[]
  domiciliosComprobante        ComparecienteDomicilio[]      @relation("DomicilioDocumentoComprobante")
  identificacionesSoporte      ComparecienteIdentificacion[]
  complianceEvidence           ComplianceEvidence[]
  comunicacionVinculos         ComunicacionDocumento[]
  cotizacionVinculos           CotizacionDocumento[]
  compareciente                Compareciente?                @relation(fields: [compareciente_id], references: [id], onUpdate: NoAction)
  cotizacion                   Cotizacion?                   @relation(fields: [cotizacion_id], references: [id])
  expediente                   Expediente?                   @relation(fields: [expediente_id], references: [id])
  prospecto                    Prospecto?                    @relation(fields: [prospecto_id], references: [id])
  subido_por                   User                          @relation(fields: [subido_por_id], references: [id])
  expedienteVinculos           ExpedienteDocumento[]
  entregasEvidencia            ExpedienteEntrega[]           @relation("ExpedienteEntregaEvidencia")
  movimientoVinculos           MovimientoDocumento[]
  instrumentosMoralSoporte     PersonaMoralInstrumento[]
  persona_moral_representantes PersonaMoralRepresentante[]
  prospectoVinculos            ProspectoDocumento[]
  matrimoniosSoporte           RelacionConyugal[]
  requisitoVinculos            RequisitoDocumentoVinculo[]
  tramitesEvidencia            TareaExterna[]                @relation("TareaExternaEvidencia")

  @@index([compareciente_id], map: "idx_documentos_compareciente_fk")
  @@index([cotizacion_id], map: "idx_documentos_cotizacion_fk")
  @@index([expediente_id], map: "idx_documentos_expediente_fk")
  @@index([prospecto_id], map: "idx_documentos_prospecto_fk")
  @@index([subido_por_id], map: "idx_documentos_subido_por_fk")
  @@map("documentos")
}

model ExpedienteDocumento {
  id                  String         @id @default(uuid()) @db.Uuid
  expediente_id       String         @db.Uuid
  documento_id        String         @db.Uuid
  tipo_vinculo        String
  fecha_vinculo       DateTime       @default(now())
  creado_por_id       String         @db.Uuid
  estatus             VinculoEstatus @default(ACTIVO)
  inactivado_at       DateTime?
  inactivado_por_id   String?        @db.Uuid
  motivo_inactivacion String?
  observaciones       String?
  creado_por          User           @relation("ExpedienteDocCreador", fields: [creado_por_id], references: [id])
  documento           Documento      @relation(fields: [documento_id], references: [id])
  expediente          Expediente     @relation(fields: [expediente_id], references: [id])

  @@unique([expediente_id, documento_id, tipo_vinculo])
  @@index([creado_por_id], map: "idx_exp_documentos_creador_fk")
  @@index([documento_id], map: "idx_exp_documentos_documento_fk")
  @@map("expediente_documentos")
}

