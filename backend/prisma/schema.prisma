generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════
// USUARIOS Y AUTENTICACIÓN
// ═══════════════════════════════════════

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  email                    String    @unique
  password_hash            String
  nombre                   String
  apellido                 String
  rol                      Role      @default(ABOGADO)
  avatar_url               String?
  activo                   Boolean   @default(true)
  password_changed_at      DateTime?
  failed_login_attempts    Int       @default(0)
  locked_until             DateTime?
  last_login_at            DateTime?
  requires_password_change Boolean   @default(true)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  expedientes               Expediente[]            @relation("ExpedienteAbogado")
  expedientesGestor         Expediente[]            @relation("ExpedienteGestor")
  expedientesCreados        Expediente[]            @relation("ExpedienteCreador")
  expedientesArchivados     Expediente[]            @relation("ExpedienteArchivedBy")
  prospectos                Prospecto[]
  archivedProspectos        Prospecto[]             @relation("ProspectoArchivedBy")
  notas                     Nota[]
  eventos                   EventoAgenda[]          @relation("EventoResponsable")
  eventosCancelados         EventoAgenda[]          @relation("EventoCanceladoPor")
  aiUsageLogs               AIUsageLog[]
  complianceRulesCreated    ComplianceRuleSet[]     @relation("ComplianceRuleCreator")
  complianceRulesApproved   ComplianceRuleSet[]     @relation("ComplianceRuleApprover")
  complianceReviewsCreated  ComplianceReview[]      @relation("ComplianceReviewCreator")
  complianceReviewsReviewed ComplianceReview[]      @relation("ComplianceReviewReviewer")
  complianceEvidenceAdded   ComplianceEvidence[]    @relation("ComplianceEvidenceAdder")
  auditLogs                 AuditLog[]
  cotizaciones              Cotizacion[]
  comunicaciones            Comunicacion[]
  seguimientosProspectos    ProspectoSeguimiento[]
  seguimientosCotizaciones  CotizacionSeguimiento[]
  documentosSubidos         Documento[]
  authSessions              AuthSession[]
  passwordResetTokens       PasswordResetToken[]

  // Relaciones con motor operativo, finanzas, auditoría y vínculos de documentos
  formularioVersionesCreadas   FormularioVersion[]          @relation("FormularioVersionCreador")
  flujoVersionesCreadas        FlujoVersion[]               @relation("FlujoVersionCreador")
  plantillaDocVersionesCreadas PlantillaDocumentalVersion[] @relation("PlantillaDocumentalVersionCreador")
  movimientosCapturados        MovimientoFinanciero[]       @relation("MovimientoCapturado")
  movimientosValidados         MovimientoFinanciero[]       @relation("MovimientoValidado")
  movimientosRevertidos        MovimientoFinanciero[]       @relation("MovimientoRevertido")
  expedienteActividades        ExpedienteActividad[]
  tareasAsignadas              Tarea[]                      @relation("TareaAsignado")
  tareasCreadas                Tarea[]                      @relation("TareaCreador")
  outboxEventosDisparados      DomainEventOutbox[]          @relation("OutboxActor")

  expedienteVinculosCreados    ExpedienteDocumento[]       @relation("ExpedienteDocCreador")
  cotizacionVinculosCreados    CotizacionDocumento[]       @relation("CotizacionDocCreador")
  comparecienteVinculosCreados ComparecienteDocumento[]    @relation("ComparecienteDocCreador")
  comparecienteDocsValidados   ComparecienteDocumento[]    @relation("ComparecienteDocValidador")
  prospectoVinculosCreados     ProspectoDocumento[]        @relation("ProspectoDocCreador")
  requisitoVinculosCreados     RequisitoDocumentoVinculo[] @relation("RequisitoDocCreador")
  movimientoVinculosCreados    MovimientoDocumento[]       @relation("MovimientoDocCreador")
  comunicacionVinculosCreados  ComunicacionDocumento[]     @relation("ComunicacionDocCreador")
  entregasRegistradas          ExpedienteEntrega[]         @relation("ExpedienteEntregaRegistrador")
  tramitesPostfirmaGestionados TareaExterna[]              @relation("TareaExternaGestor")

  comparecientesCreados                  Compareciente[]               @relation("ComparecienteCreador")
  instrumentosMoralCreados               PersonaMoralInstrumento[]     @relation("InstrumentoCreador")
  instrumentosMoralValidados             PersonaMoralInstrumento[]     @relation("InstrumentoValidador")
  domiciliosComparecienteCreados         ComparecienteDomicilio[]      @relation("DomicilioCreador")
  contactosComparecienteCreados          ComparecienteContacto[]       @relation("ContactoCreador")
  identificacionesComparecienteCreadas   ComparecienteIdentificacion[] @relation("IdentificacionCreador")
  identificacionesComparecienteValidadas ComparecienteIdentificacion[] @relation("IdentificacionValidador")
  representantesCorporativosCreados      PersonaMoralRepresentante[]   @relation("RepresentanteCorporativoCreador")
  expedienteComparecientesCreados        ExpedienteCompareciente[]     @relation("ExpedienteComparecienteCreador")
  expedienteComparecientesValidados      ExpedienteCompareciente[]     @relation("ExpedienteComparecienteValidador")
  expedienteRepresentacionesCreadas      ExpedienteRepresentacion[]    @relation("ExpedienteRepresentacionCreador")
  expedienteRepresentacionesValidadas    ExpedienteRepresentacion[]    @relation("ExpedienteRepresentacionValidador")

  comparecienteAltaSessions ComparecienteAltaSession[] @relation("ComparecienteAltaSessionUsuario")
  cargasTemporales          CargaTemporalDocumento[]   @relation("CargaTemporalUsuario")
  datosFuenteConfirmados    ComparecienteDatoFuente[]  @relation("DatoFuenteConfirmador")

  @@map("users")
}

enum Role {
  DIRECCION
  ADMINISTRACION
  ABOGADO
  RECEPCION
  GESTORIA
  CONSULTA
}

model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @unique
  user_agent         String?
  ip_address         String?
  expires_at         DateTime
  last_used_at       DateTime  @default(now())
  revoked_at         DateTime?
  revoked_reason     String?
  rotated_from_id    String?   @db.Uuid
  created_at         DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at, expires_at])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  token_hash   String    @unique
  expires_at   DateTime
  used_at      DateTime?
  requested_ip String?
  created_at   DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, used_at, expires_at])
  @@map("password_reset_tokens")
}

// ═══════════════════════════════════════
// PROSPECTOS Y NOTARÍAS
// ═══════════════════════════════════════

model Prospecto {
  id                     String             @id @default(uuid()) @db.Uuid
  nombre                 String
  telefono               String?
  email                  String?
  tipo_acto              String?
  necesidad              String?
  documentos_disponibles String?
  tiene_antecedente      Boolean?
  tiene_predial          Boolean?
  puede_compartir_docs   Boolean?
  tiempo_estimado        String?
  ciudad                 String?
  fuente                 String?
  prioridad              ProspectoPrioridad @default(MEDIA)
  estado                 ProspectoEstado    @default(NUEVO)
  user_id                String             @db.Uuid

  archived_at    DateTime?
  archived_by    String?   @db.Uuid
  motivo_archivo String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  atendido_por        User                   @relation(fields: [user_id], references: [id])
  archived_by_user    User?                  @relation("ProspectoArchivedBy", fields: [archived_by], references: [id])
  seguimientos        ProspectoSeguimiento[]
  cotizacion          Cotizacion?
  documentos          Documento[]
  prospectoDocumentos ProspectoDocumento[]

  @@map("prospectos")
}

enum ProspectoPrioridad {
  BAJA
  MEDIA
  ALTA
}

enum ProspectoEstado {
  NUEVO
  INFO_PENDIENTE
  DOCS_RECIBIDOS
  EN_REVISION
  COTIZACION_SOLICITADA
  COTIZACION_ENVIADA
  SEGUIMIENTO
  ACEPTADO
  PERDIDO
  CANCELADO
  ARCHIVADO
}

model ProspectoSeguimiento {
  id                        String    @id @default(uuid()) @db.Uuid
  prospecto_id              String    @db.Uuid
  usuario_id                String    @db.Uuid
  tipo                      String
  contenido                 String
  proxima_accion            String?
  fecha_proximo_seguimiento DateTime?
  created_at                DateTime  @default(now())

  prospecto Prospecto @relation(fields: [prospecto_id], references: [id], onDelete: Cascade)
  usuario   User      @relation(fields: [usuario_id], references: [id])

  @@map("prospecto_seguimientos")
}

model Notaria {
  id                 String  @id @default(uuid()) @db.Uuid
  numero_notaria     String?
  nombre             String
  notario_titular    String?
  ciudad             String?
  entidad_federativa String  @default("Nayarit")
  municipio          String  @default("Tepic")
  demarcacion        String?
  direccion          String?
  codigo_postal      String?

  // Contacto
  telefono           String?
  whatsapp           String?
  correo_general     String?
  correo_proyectos   String?
  pagina_web         String?
  contacto_principal String?

  // Información Operativa
  horario                  String?
  dias_atencion            String?
  tiempo_respuesta         String?
  tiempo_presupuesto       String?
  tiempo_firma             String?
  instrucciones_especiales String?
  observaciones_generales  String?
  requisitos_frecuentes    String?
  dias_respuesta_estimados Int     @default(5)

  // Configuración
  activa                    Boolean @default(true)
  predeterminada            Boolean @default(false)
  color_identificador       String? @default("#D4AF37")
  tipos_acto_json           Json?
  instituciones_json        Json?
  municipios_atendidos_json Json?

  archived_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  contactos             NotariaContacto[]
  cotizaciones          Cotizacion[]
  expedientes           Expediente[]
  plantillaDocumentales PlantillaDocumentalVersion[]

  @@map("notarias")
}

model NotariaContacto {
  id            String   @id @default(uuid()) @db.Uuid
  notaria_id    String   @db.Uuid
  nombre        String
  cargo         String // Abogado, Proyectista, Gestor, Administración, Contabilidad, Recepción
  telefono      String?
  whatsapp      String?
  correo        String?
  observaciones String?
  activo        Boolean  @default(true)
  created_at    DateTime @default(now())

  notaria Notaria @relation(fields: [notaria_id], references: [id], onDelete: Cascade)

  @@map("notaria_contactos")
}

// ═══════════════════════════════════════
// COTIZACIONES (RESPETANDO ARQUITECTURA VIGENTE SIN REGRESIONES)
// ═══════════════════════════════════════

model Cotizacion {
  id                String           @id @default(uuid()) @db.Uuid
  numero_solicitud  String?          @unique
  numero_cotizacion String?          @unique
  version_actual    Int              @default(1)
  prospecto_id      String?          @unique @db.Uuid
  user_id           String           @db.Uuid
  notaria_id        String?          @db.Uuid
  estado            CotizacionEstado @default(BORRADOR)

  fecha_solicitud_notaria        DateTime?
  fecha_limite_respuesta_notaria DateTime?
  fecha_presupuesto_recibido     DateTime?
  fecha_enviada_cliente          DateTime?
  fecha_aceptacion_cliente       DateTime?
  fecha_aprobacion_version       DateTime?
  fecha_conversion_expediente    DateTime?

  total_notaria     Decimal? @db.Decimal(14, 2)
  honorarios_pravia Decimal? @db.Decimal(14, 2)
  total_cliente     Decimal? @db.Decimal(14, 2)

  cuerpo_correo_notaria String?
  cuerpo_correo_cliente String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  prospecto              Prospecto?              @relation(fields: [prospecto_id], references: [id])
  creada_por             User                    @relation(fields: [user_id], references: [id])
  notaria                Notaria?                @relation(fields: [notaria_id], references: [id])
  versiones              CotizacionVersion[]
  expediente             Expediente?
  documentos             Documento[]
  cotizacionDocumentos   CotizacionDocumento[]
  pagos                  Pago[]
  movimientosFinancieros MovimientoFinanciero[]
  seguimientos           CotizacionSeguimiento[]

  @@map("cotizaciones")
}

enum CotizacionEstado {
  BORRADOR
  ENVIADA_NOTARIA
  PRESUPUESTO_RECIBIDO
  EN_REVISION_ABOGADO
  ENVIADA_CLIENTE
  EN_NEGOCIACION
  ACEPTADA
  RECHAZADA
  VENCIDA
  CONVERTIDA_EXPEDIENTE
}

model CotizacionVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  cotizacion_id       String   @db.Uuid
  version             Int
  desglose_notaria    Json?
  desglose_pravia     Json?
  total_notaria       Decimal  @db.Decimal(14, 2)
  honorarios_pravia   Decimal  @db.Decimal(14, 2)
  total_cliente       Decimal  @db.Decimal(14, 2)
  montos_extraidos_ia Json?
  notas               String?
  pdf_url             String?
  aprobada            Boolean  @default(false)
  created_at          DateTime @default(now())
  creada_por_id       String?  @db.Uuid

  cotizacion Cotizacion @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade)

  @@unique([cotizacion_id, version])
  @@map("cotizacion_versiones")
}

model CotizacionSeguimiento {
  id                        String    @id @default(uuid()) @db.Uuid
  cotizacion_id             String    @db.Uuid
  usuario_id                String    @db.Uuid
  tipo                      String
  destinatario              String
  resumen                   String
  resultado                 String?
  proxima_accion            String?
  responsable               String?
  fecha_proximo_seguimiento DateTime?
  created_at                DateTime  @default(now())

  cotizacion Cotizacion @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade)
  usuario    User       @relation(fields: [usuario_id], references: [id])

  @@map("cotizacion_seguimientos")
}

// ═══════════════════════════════════════
// MOTOR CONFIGURABLE Y VERSIONADO POR TIPO DE ACTO
// ═══════════════════════════════════════

model TipoActo {
  id                 String    @id @default(uuid()) @db.Uuid
  nombre             String
  descripcion        String?
  machote_referencia String?
  activo             Boolean   @default(true)
  archived_at        DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt

  checklist                       ChecklistItem[]
  expedientes                     Expediente[]
  formularioSecciones             FormularioSeccion[]
  flujoEtapas                     FlujoEtapa[]
  formularioVersiones             FormularioVersion[]
  flujoVersiones                  FlujoVersion[]
  plantillaDocVersiones           PlantillaDocumentalVersion[]
  tipoActoCaracteresCompareciente TipoActoCaracterCompareciente[]

  @@map("tipos_acto")
}

model FormularioSeccion {
  id           String  @id @default(uuid()) @db.Uuid
  tipo_acto_id String  @db.Uuid
  clave        String
  titulo       String
  orden        Int     @default(0)
  descripcion  String?

  tipo_acto TipoActo          @relation(fields: [tipo_acto_id], references: [id], onDelete: Restrict)
  campos    FormularioCampo[]

  @@unique([tipo_acto_id, clave])
  @@map("formulario_secciones")
}

model FormularioCampo {
  id                         String  @id @default(uuid()) @db.Uuid
  seccion_id                 String  @db.Uuid
  clave_tecnica              String
  etiqueta                   String
  tipo_dato                  String
  orden                      Int     @default(0)
  obligatorio                Boolean @default(false)
  valor_predeterminado       String?
  opciones_json              Json?
  validaciones_json          Json?
  condicion_visibilidad_json Json?
  texto_ayuda                String?
  activo                     Boolean @default(true)

  seccion FormularioSeccion @relation(fields: [seccion_id], references: [id], onDelete: Cascade)

  @@unique([seccion_id, clave_tecnica])
  @@map("formulario_campos")
}

model FlujoEtapa {
  id                         String  @id @default(uuid()) @db.Uuid
  tipo_acto_id               String  @db.Uuid
  clave                      String
  nombre                     String
  orden                      Int     @default(1)
  obligatoria                Boolean @default(true)
  se_puede_omitir            Boolean @default(false)
  duracion_esperada_dias     Int     @default(3)
  estado_general_relacionado String
  etapa_siguiente_id         String? @db.Uuid
  reglas_entrada_json        Json?
  reglas_salida_json         Json?
  activa                     Boolean @default(true)

  tipo_acto        TipoActo          @relation(fields: [tipo_acto_id], references: [id], onDelete: Restrict)
  expedienteEtapas ExpedienteEtapa[]

  @@unique([tipo_acto_id, clave])
  @@map("flujo_etapas")
}

model FormularioVersion {
  id             String   @id @default(uuid()) @db.Uuid
  tipo_acto_id   String   @db.Uuid
  version        Int      @default(1)
  secciones_json Json
  campos_json    Json
  vigente_desde  DateTime @default(now())
  creado_por_id  String   @db.Uuid

  tipo_acto   TipoActo     @relation(fields: [tipo_acto_id], references: [id], onDelete: Restrict)
  creado_por  User         @relation("FormularioVersionCreador", fields: [creado_por_id], references: [id])
  expedientes Expediente[]

  @@unique([tipo_acto_id, version])
  @@map("formulario_versiones")
}

model FlujoVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  tipo_acto_id       String   @db.Uuid
  version            Int      @default(1)
  etapas_json        Json
  ponderaciones_json Json?
  vigente_desde      DateTime @default(now())
  creado_por_id      String   @db.Uuid

  tipo_acto        TipoActo          @relation(fields: [tipo_acto_id], references: [id], onDelete: Restrict)
  creado_por       User              @relation("FlujoVersionCreador", fields: [creado_por_id], references: [id])
  expedientes      Expediente[]
  expedienteEtapas ExpedienteEtapa[]

  @@unique([tipo_acto_id, version])
  @@map("flujo_versiones")
}

model PlantillaDocumentalVersion {
  id              String   @id @default(uuid()) @db.Uuid
  tipo_acto_id    String   @db.Uuid
  notaria_id      String?  @db.Uuid
  version         Int      @default(1)
  nombre          String?
  storage_key     String?
  mime_type       String?
  size_bytes      Int?
  checksum_sha256 String?
  activa          Boolean  @default(true)
  requisitos_json Json
  vigente_desde   DateTime @default(now())
  creado_por_id   String   @db.Uuid

  tipo_acto   TipoActo     @relation(fields: [tipo_acto_id], references: [id], onDelete: Restrict)
  notaria     Notaria?     @relation(fields: [notaria_id], references: [id], onDelete: SetNull)
  creado_por  User         @relation("PlantillaDocumentalVersionCreador", fields: [creado_por_id], references: [id])
  expedientes Expediente[]

  @@unique([tipo_acto_id, notaria_id, version])
  @@index([tipo_acto_id, notaria_id, activa])
  @@map("plantilla_documental_versiones")
}

model ChecklistItem {
  id           String       @id @default(uuid()) @db.Uuid
  tipo_acto_id String       @db.Uuid
  nombre       String
  descripcion  String?
  categoria    DocCategoria @default(PROYECTO)
  obligatorio  Boolean      @default(true)
  orden        Int          @default(0)

  tipo_acto TipoActo @relation(fields: [tipo_acto_id], references: [id], onDelete: Restrict)

  @@map("checklist_items")
}

enum DocCategoria {
  PROYECTO
  FIRMA
  REGISTRO
  CATASTRO
  UIF
  BANCO
  SAT
  FIDEICOMISO
  OTROS
}

// ═══════════════════════════════════════
// EXPEDIENTES (CENTRO OPERATIVO DEL SISTEMA)
// ═══════════════════════════════════════

model Expediente {
  id             String  @id @default(uuid()) @db.Uuid
  numero_pravia  String  @unique
  numero_notaria String?

  version Int @default(1) // Control de Concurrencia Optimista

  tipo_acto_id  String  @db.Uuid
  subtipo_acto  String?
  abogado_id    String  @db.Uuid
  gestor_id     String? @db.Uuid
  creador_id    String  @db.Uuid
  cotizacion_id String? @unique @db.Uuid
  notaria_id    String? @db.Uuid

  formulario_version_id    String? @db.Uuid
  flujo_version_id         String? @db.Uuid
  plantilla_doc_version_id String? @db.Uuid

  cliente_alias   String?
  descripcion     String?
  valor_operacion Decimal? @db.Decimal(14, 2)
  datos_operacion Json?

  estatus                    ExpedienteEstatus @default(ABIERTO)
  expediente_etapa_actual_id String?           @unique @db.Uuid
  etapa_actual_nombre        String?           @default("Apertura de Expediente")

  avance_documental Int @default(0)
  avance_operativo  Int @default(0)
  avance_financiero Int @default(0)
  avance_general    Int @default(0)

  proxima_accion      String?
  fecha_limite_accion DateTime?

  fecha_apertura        DateTime  @default(now())
  fecha_estimada_firma  DateTime?
  fecha_real_firma      DateTime?
  fecha_entrega_cliente DateTime?

  archived_at    DateTime?
  archived_by    String?   @db.Uuid
  motivo_archivo String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  tipo_acto           TipoActo                    @relation(fields: [tipo_acto_id], references: [id], onDelete: Restrict)
  abogado             User                        @relation("ExpedienteAbogado", fields: [abogado_id], references: [id], onDelete: Restrict)
  gestor              User?                       @relation("ExpedienteGestor", fields: [gestor_id], references: [id], onDelete: SetNull)
  creador             User                        @relation("ExpedienteCreador", fields: [creador_id], references: [id], onDelete: Restrict)
  archived_by_user    User?                       @relation("ExpedienteArchivedBy", fields: [archived_by], references: [id], onDelete: SetNull)
  cotizacion          Cotizacion?                 @relation(fields: [cotizacion_id], references: [id], onDelete: Restrict)
  notaria             Notaria?                    @relation(fields: [notaria_id], references: [id], onDelete: SetNull)
  formularioVersion   FormularioVersion?          @relation(fields: [formulario_version_id], references: [id], onDelete: SetNull)
  flujoVersion        FlujoVersion?               @relation(fields: [flujo_version_id], references: [id], onDelete: SetNull)
  plantillaDocVersion PlantillaDocumentalVersion? @relation(fields: [plantilla_doc_version_id], references: [id], onDelete: SetNull)
  etapaActual         ExpedienteEtapa?            @relation("ExpedienteEtapaActual", fields: [expediente_etapa_actual_id], references: [id], onDelete: SetNull)

  comparecientes             ExpedienteCompareciente[]
  expedienteRepresentaciones ExpedienteRepresentacion[]
  requisitos_docs            ExpedienteRequisitoDoc[]
  documentos                 Documento[]
  expedienteDocumentos       ExpedienteDocumento[]
  pagos                      Pago[]
  movimientosFinancieros     MovimientoFinanciero[]
  comunicaciones             Comunicacion[]
  tareas                     Tarea[]
  actividades                ExpedienteActividad[]
  comparecienteAltaSessions  ComparecienteAltaSession[] @relation("ComparecienteAltaSessionOrigenExpediente")
  estatus_logs               ExpedienteEstatus_Log[]
  etapas                     ExpedienteEtapa[]          @relation("ExpedienteEtapasLista")
  tareas_externas            TareaExterna[]
  eventos                    EventoAgenda[]
  aiUsageLogs                AIUsageLog[]
  complianceReviews          ComplianceReview[]
  entrega                    ExpedienteEntrega?

  @@map("expedientes")
}

enum ExpedienteEstatus {
  ABIERTO
  EN_INTEGRACION
  EN_PROCESO
  PENDIENTE_CLIENTE
