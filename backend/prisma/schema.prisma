  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  archived_at          DateTime?

  persona1         PersonaFisica @relation("ConyugePersona1", fields: [persona_1_id], references: [id], onDelete: Restrict)
  persona2         PersonaFisica @relation("ConyugePersona2", fields: [persona_2_id], references: [id], onDelete: Restrict)
  documentoSoporte Documento?    @relation(fields: [documento_soporte_id], references: [id], onDelete: SetNull)

