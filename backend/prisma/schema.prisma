model Compareciente {
  id                                String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo_persona                      TipoPersona                       @default(FISICA)
  nombre_busqueda                   String                            @db.VarChar(255)
  estatus                           ComparecienteEstatus              @default(ACTIVO)
  creado_por_id                     String                            @db.Uuid
  created_at                        DateTime?                         @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime?                         @default(now()) @updatedAt @db.Timestamptz(6)
  archived_at                       DateTime?                         @db.Timestamptz(6)
  version                           Int                               @default(1)
  actividadesEconomicas             ComparecienteActividadEconomica[]
  aliases                           ComparecienteAlias[]
  contactos                         ComparecienteContacto[]
  datosFuente                       ComparecienteDatoFuente[]
  documentos                        ComparecienteDocumento[]
  domicilios                        ComparecienteDomicilio[]
  identificaciones                  ComparecienteIdentificacion[]
  creado_por                        User                              @relation("ComparecienteCreador", fields: [creado_por_id], references: [id], onUpdate: NoAction)
  documentosDirectos                Documento[]
  eventosAgenda                     EventoAgenda[]
  expedientes                       ExpedienteCompareciente[]
  representacionesComoRepresentado  ExpedienteRepresentacion[]        @relation("RepresentadoExpediente")
  representacionesComoRepresentante ExpedienteRepresentacion[]        @relation("RepresentanteExpediente")
  movimientosFinancieros            MovimientoFinanciero[]
  personaFisica                     PersonaFisica?
  personaMoral                      PersonaMoral?

  @@index([creado_por_id], map: "idx_comparecientes_creado_por_fk")
  @@index([nombre_busqueda], map: "idx_comparecientes_nombre_busqueda")
  @@index([tipo_persona], map: "idx_comparecientes_tipo_persona")
  @@map("comparecientes")
}

model PersonaFisica {
  id                            String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compareciente_id              String                      @unique @db.Uuid
  nombre                        String                      @db.VarChar(100)
  apellido_paterno              String?                     @db.VarChar(100)
  apellido_materno              String?                     @db.VarChar(100)
  nombre_completo_calculado     String                      @db.VarChar(300)
  sexo                          Sexo?
  fecha_nacimiento              DateTime?                   @db.Date
  lugar_nacimiento              String?                     @db.VarChar(150)
  nacionalidad                  String?                     @default("Mexicana") @db.VarChar(100)
  curp                          String?                     @db.VarChar(18)
  rfc                           String?                     @db.VarChar(13)
  estado_civil                  EstadoCivil?
  regimen_matrimonial           RegimenMatrimonial?
  ocupacion                     String?                     @db.VarChar(150)
  calidad_migratoria            String?                     @db.VarChar(100)
  actividad_economica           String?                     @db.VarChar(200)
  requiere_interprete           Boolean?                    @default(false)
  idioma                        String?                     @default("Español") @db.VarChar(50)
  pep                           Boolean?                    @default(false)
  relacion_pep                  String?                     @db.VarChar(200)
  created_at                    DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime?                   @default(now()) @updatedAt @db.Timestamptz(6)
  archived_at                   DateTime?                   @db.Timestamptz(6)
  pep_estado                    PepEstado                   @default(PENDIENTE)
  pais_nacimiento               String?                     @db.VarChar
  escolaridad                   String?                     @db.VarChar
  giro                          String?                     @db.VarChar
  representacionesEmpresariales PersonaMoralRepresentante[] @relation("RepresentanteFisico")
  compareciente                 Compareciente               @relation(fields: [compareciente_id], references: [id], onUpdate: NoAction)
  matrimoniosComoPersona1       RelacionConyugal[]          @relation("ConyugePersona1")
  matrimoniosComoPersona2       RelacionConyugal[]          @relation("ConyugePersona2")

  @@index([nombre_completo_calculado], map: "idx_personas_fisicas_nombre")
  @@map("personas_fisicas")
}

model RelacionConyugal {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  persona_1_id         String              @db.Uuid
  persona_2_id         String              @db.Uuid
  regimen_matrimonial  RegimenMatrimonial? @default(SOCIEDAD_CONYUGAL)
  fecha_matrimonio     DateTime?           @db.Date
  lugar_matrimonio     String?             @db.VarChar(150)
  documento_soporte_id String?             @db.Uuid
  vigente              Boolean?            @default(true)
  created_at           DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?           @default(now()) @updatedAt @db.Timestamptz(6)
  archived_at          DateTime?           @db.Timestamptz(6)
  documentoSoporte     Documento?          @relation(fields: [documento_soporte_id], references: [id], onUpdate: NoAction)
  persona1             PersonaFisica       @relation("ConyugePersona1", fields: [persona_1_id], references: [id], onUpdate: NoAction)
  persona2             PersonaFisica       @relation("ConyugePersona2", fields: [persona_2_id], references: [id], onUpdate: NoAction)

  @@index([documento_soporte_id], map: "idx_rel_conyugales_documento_fk")
  @@index([persona_1_id], map: "idx_rel_conyugales_persona_1_fk")
  @@index([persona_2_id], map: "idx_rel_conyugales_persona_2_fk")
  @@map("relaciones_conyugales")
}

model PersonaMoral {
  id                          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compareciente_id            String                      @unique @db.Uuid
  razon_social                String                      @db.VarChar(255)
  nombre_comercial            String?                     @db.VarChar(255)
  tipo_societario             String?                     @db.VarChar(100)
  nacionalidad                String?                     @default("Mexicana") @db.VarChar(100)
  rfc                         String?                     @db.VarChar(13)
  fecha_constitucion          DateTime?                   @db.Date
  duracion                    String?                     @default("Indefinida") @db.VarChar(100)
  objeto_social_resumido      String?
  folio_mercantil             String?                     @db.VarChar(100)
  fecha_inscripcion_mercantil DateTime?                   @db.Date
  estatus_societario          String?                     @default("ACTIVA") @db.VarChar(50)
  created_at                  DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime?                   @default(now()) @updatedAt @db.Timestamptz(6)
  archived_at                 DateTime?                   @db.Timestamptz(6)
