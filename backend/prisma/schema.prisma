model Cotizacion {
  id                             String                      @id @default(uuid()) @db.Uuid
  organization_id                String?                     @db.Uuid
  prospecto_id                   String?                     @unique @db.Uuid
  user_id                        String                      @db.Uuid
  estado                         CotizacionEstado            @default(BORRADOR)
  created_at                     DateTime                    @default(now())
  updated_at                     DateTime                    @default(now()) @updatedAt
  cuerpo_correo_cliente          String?
  cuerpo_correo_notaria          String?
  fecha_aceptacion_cliente       DateTime?
  fecha_enviada_cliente          DateTime?
  fecha_limite_respuesta_notaria DateTime?
  fecha_presupuesto_recibido     DateTime?
  fecha_solicitud_notaria        DateTime?
  honorarios_pravia              Decimal?                    @db.Decimal(14, 2)
  notaria_id                     String?                     @db.Uuid
  numero_cotizacion              String?                     @unique
  numero_solicitud               String?                     @unique
  fuente_notarial_id             String?                     @db.Uuid
  fuente_notarial                ProspectoFuenteNotarial?    @relation(fields: [fuente_notarial_id], references: [id], onDelete: Restrict)
  total_cliente                  Decimal?                    @db.Decimal(14, 2)
  total_notaria                  Decimal?                    @db.Decimal(14, 2)
  version_actual                 Int                         @default(1)
  fecha_aprobacion_version       DateTime?
  fecha_conversion_expediente    DateTime?
  etapa_contractual              CotizacionEtapaContractual?
  version_operativa              Int                         @default(0)
  transicion_actual_id           String?                     @db.Uuid
  cotizacionDocumentos           CotizacionDocumento[]
  seguimientos                   CotizacionSeguimiento[]
  versiones                      CotizacionVersion[]
  notaria                        Notaria?                    @relation(fields: [notaria_id], references: [id])
  prospecto                      Prospecto?                  @relation(fields: [prospecto_id], references: [id])
  creada_por                     User                        @relation(fields: [user_id], references: [id])
  documentos                     Documento[]
  expediente                     Expediente?
  expedienteActosOrigen          ExpedienteActo[]
  honorariosGenerados            HonorarioGenerado?
  movimientosFinancieros         MovimientoFinanciero[]
  pagos                          Pago[]
  transicion_actual              CotizacionTransicion?       @relation("CotizacionCurrentTransition", fields: [transicion_actual_id], references: [id], onDelete: Restrict)
  transiciones                   CotizacionTransicion[]      @relation("CotizacionTransitions")

  @@unique([id, organization_id], map: "uq_cotizaciones_id_org")
  @@index([notaria_id], map: "idx_cotizaciones_notaria_fk")
  @@index([user_id], map: "idx_cotizaciones_user_fk")
  @@index([fuente_notarial_id, organization_id], map: "idx_cotizaciones_source_org")
  @@index([transicion_actual_id], map: "idx_cotizacion_current_transition")
  @@index([organization_id, etapa_contractual], map: "idx_cotizacion_contract_stage")
  @@map("cotizaciones")
}

enum CotizacionEtapaContractual {
  BORRADOR
  ENVIADA_CLIENTE
  ACEPTO_ANTICIPO
  SUSPENDIDA
  CANCELADA
  CONVERTIDA_EXPEDIENTE
}

// Hechos comerciales append-only. AuditLog conserva auditoría técnica, no sustituye esta historia.
model CotizacionTransicion {
  id                    String                      @id @default(uuid()) @db.Uuid
  organization_id       String                      @db.Uuid
  cotizacion_id         String                      @db.Uuid
  actor_id              String                      @db.Uuid
  etapa_anterior        CotizacionEtapaContractual?
  etapa_nueva           CotizacionEtapaContractual
  effective_at          DateTime
  recorded_at           DateTime                    @default(now())
  accion                String                      @db.VarChar(60)
  procedencia           String                      @db.VarChar(60)
  canal                 String?                     @db.VarChar(100)
  destinatario          String?                     @db.VarChar(320)
  causa                 String?
  evidencia             Json
  version               Int
  idempotency_key       String                      @db.VarChar(120)
  payload_hash          String                      @db.VarChar(64)
  cambia_etapa          Boolean                     @default(true)
  cotizacion_version_id String?                     @db.Uuid
  organization          Organization                @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  cotizacion            Cotizacion                  @relation("CotizacionTransitions", fields: [cotizacion_id], references: [id], onDelete: Restrict)
  actor                 OrganizationMembership      @relation(fields: [organization_id, actor_id], references: [organization_id, user_id], onDelete: Restrict)
  cotizacion_version    CotizacionVersion?          @relation(fields: [cotizacion_version_id], references: [id], onDelete: Restrict)
  actual_para           Cotizacion[]                @relation("CotizacionCurrentTransition")

  @@unique([organization_id, cotizacion_id, idempotency_key], map: "uq_cotizacion_transition_key")
  @@unique([cotizacion_id, version], map: "uq_cotizacion_transition_version")
  @@index([organization_id, actor_id], map: "idx_cotizacion_transition_actor")
  @@index([cotizacion_id, organization_id, effective_at], map: "idx_cotizacion_transition_history")
  @@index([cotizacion_version_id], map: "idx_cotizacion_transition_version_fk")
  @@map("cotizacion_transiciones")
}

model CotizacionVersion {
  id                  String                  @id @default(uuid()) @db.Uuid
  organization_id     String?                 @db.Uuid
  cotizacion_id       String                  @db.Uuid
  version             Int
  total_cliente       Decimal                 @db.Decimal(14, 2)
  notas               String?
  pdf_url             String?
  created_at          DateTime                @default(now())
  creada_por_id       String?                 @db.Uuid
  desglose_notaria    Json?
  desglose_pravia     Json?
  honorarios_pravia   Decimal                 @db.Decimal(14, 2)
  montos_extraidos_ia Json?
  total_notaria       Decimal                 @db.Decimal(14, 2)
  aprobada            Boolean                 @default(false)
  cotizacion          Cotizacion              @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade)
  honorariosGenerados HonorarioGenerado[]
  presupuestosOrigen  ExpedientePresupuesto[]
  transiciones        CotizacionTransicion[]

  @@unique([cotizacion_id, version])
  @@map("cotizacion_versiones")
}

model CotizacionSeguimiento {
  id                        String     @id @default(uuid()) @db.Uuid
