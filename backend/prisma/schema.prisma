  @@unique([tipo_acto_id, version])
  @@index([creado_por_id], map: "idx_formulario_versiones_creador_fk")
  @@map("formulario_versiones")
}

model FlujoVersion {
  id                 String            @id @default(uuid()) @db.Uuid
  tipo_acto_id       String            @db.Uuid
  version            Int               @default(1)
  etapas_json        Json
  ponderaciones_json Json?
  vigente_desde      DateTime          @default(now())
  creado_por_id      String            @db.Uuid
  expedienteEtapas   ExpedienteEtapa[]
  expedientes        Expediente[]
  creado_por         User              @relation("FlujoVersionCreador", fields: [creado_por_id], references: [id])
  tipo_acto          TipoActo          @relation(fields: [tipo_acto_id], references: [id])

  @@unique([tipo_acto_id, version])
  @@index([creado_por_id], map: "idx_flujo_versiones_creador_fk")
  @@map("flujo_versiones")
}

model PlantillaDocumentalVersion {
  id              String       @id @default(uuid()) @db.Uuid
  tipo_acto_id    String       @db.Uuid
  version         Int          @default(1)
  requisitos_json Json
  vigente_desde   DateTime     @default(now())
  creado_por_id   String       @db.Uuid
  notaria_id      String?      @db.Uuid
  nombre          String?
  storage_key     String?
  mime_type       String?
  size_bytes      Int?
  checksum_sha256 String?
  activa          Boolean      @default(true)
  expedientes     Expediente[]
  creado_por      User         @relation("PlantillaDocumentalVersionCreador", fields: [creado_por_id], references: [id])
  notaria         Notaria?     @relation(fields: [notaria_id], references: [id])
  tipo_acto       TipoActo     @relation(fields: [tipo_acto_id], references: [id])

  @@unique([tipo_acto_id, notaria_id, version], map: "plantilla_documental_versiones_tipo_acto_id_notaria_id_version_")
  @@index([creado_por_id], map: "idx_plantilla_versiones_creador_fk")
  @@index([tipo_acto_id, notaria_id, activa], map: "plantilla_documental_versiones_tipo_acto_id_notaria_id_activa_i")
  @@map("plantilla_documental_versiones")
}

model ConfiguracionActo {
  id                        String               @id @default(uuid()) @db.Uuid
  organization_id           String               @db.Uuid
  tipo_acto_id              String               @db.Uuid
  activa                    Boolean              @default(true)
  requiere_revision         Boolean              @default(true)
  revision                  Int                  @default(1)
  nombre_personalizado      String?
  descripcion_personalizada String?
  /// Familia funcional y configuración base reutilizada por variantes CFG-001 v2.
  familia                   String?
  hereda_configuracion_id   String?              @db.Uuid
  exclusiones_conceptos     Json?
  creado_por_id             String               @db.Uuid
  actualizado_por_id        String               @db.Uuid
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt
  etapas                    ConfiguracionEtapa[]
  tipo_acto                 TipoActo             @relation(fields: [tipo_acto_id], references: [id], onDelete: Restrict)
  hereda_configuracion      ConfiguracionActo?   @relation("ConfiguracionActoInheritance", fields: [hereda_configuracion_id, organization_id], references: [id, organization_id], onDelete: Restrict, map: "configuracion_actos_hereda_configuracion_id_fkey")
  configuraciones_heredadas ConfiguracionActo[]  @relation("ConfiguracionActoInheritance")

  @@unique([organization_id, tipo_acto_id], map: "uq_config_acto_org_tipo")
  @@unique([id, organization_id], map: "uq_config_acto_id_org")
  @@index([organization_id, hereda_configuracion_id], map: "idx_cfg_actos_base")
  @@index([tipo_acto_id], map: "idx_config_actos_tipo_acto_fk")
  @@map("configuracion_actos")
}

model ConfiguracionEtapa {
  id               String                   @id @default(uuid()) @db.Uuid
  organization_id  String                   @db.Uuid
  configuracion_id String                   @db.Uuid
  nombre           String
  orden            Int
  activa           Boolean                  @default(true)
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt
  configuracion    ConfiguracionActo        @relation(fields: [configuracion_id], references: [id], onDelete: Cascade)
  actividades      ConfiguracionActividad[]

  @@unique([configuracion_id, orden], map: "uq_config_etapas_orden")
  @@index([organization_id, configuracion_id], map: "idx_config_etapas_tenant_parent")
  @@map("configuracion_etapas")
}

model ConfiguracionActividad {
  id                     String                              @id @default(uuid()) @db.Uuid
  organization_id        String                              @db.Uuid
  etapa_id               String                              @db.Uuid
  /// Concepto semántico reutilizable. Los campos heredados se resuelven desde esta fuente.
  concepto_maestro_id    String?                             @db.Uuid
  nombre                 String
  descripcion            String?
  duracion_estimada      Int
  tipo_dias              ConfiguracionTipoDias
  margen_seguridad       Int                                 @default(0)
  responsable_rol        Role?
  responsable_usuario_id String?                             @db.Uuid
