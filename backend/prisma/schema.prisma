model TipoActo {
  id                              String                          @id @default(uuid()) @db.Uuid
  organization_id                 String?                         @db.Uuid
  codigo_catalogo                 String?                         @unique
  nombre                          String
  descripcion                     String?
  machote_referencia              String?
  activo                          Boolean                         @default(true)
