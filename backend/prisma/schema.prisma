model MovimientoFinanciero {
  id                      String                       @id @default(uuid()) @db.Uuid
  organization_id         String?                      @db.Uuid
  expediente_id           String?                      @db.Uuid
  cotizacion_id           String?                      @db.Uuid
  tipo_movimiento         TipoMovimiento
  naturaleza              NaturalezaMovimiento
  categoria               String
  concepto                String
  monto                   Decimal                      @db.Decimal(14, 2)
  fecha_movimiento        DateTime                     @default(now())
  forma_pago              String?
  cuenta_receptora        String?
  referencia              String?
  comprobante_url         String?
  factura_url             String?
  estatus                 EstatusMovimiento            @default(PENDIENTE)
  capturado_por_id        String                       @db.Uuid
  validado_por_id         String?                      @db.Uuid
  fecha_validacion        DateTime?
  movimiento_origen_id    String?                      @db.Uuid
  motivo_reversion        String?
  revertido_por_id        String?                      @db.Uuid
  fecha_reversion         DateTime?
  folio                   String?                      @unique
  compareciente_id        String?                      @db.Uuid
  notaria_id              String?                      @db.Uuid
  responsable_id          String?                      @db.Uuid
  cuenta_id               String?                      @db.Uuid
  descripcion             String?
  fecha_registro          DateTime                     @default(now())
  updated_at              DateTime                     @default(now()) @updatedAt
  idempotency_key         String?                      @unique
  aplicado_por_id         String?                      @db.Uuid
  fecha_aplicacion        DateTime?
  cancelado_por_id        String?                      @db.Uuid
  fecha_cancelacion       DateTime?
  motivo_cancelacion      String?
  comprobanteInterno      ComprobanteFinanciero?
  conciliaciones          ConciliacionFinanciera[]
  distribuciones          MovimientoDistribucion[]
  movimientoDocumentos    MovimientoDocumento[]
  ingresoReportadoExp008  ExpedienteIngresoReportado?
  solicitudPagoExp008     ExpedienteSolicitudPago?
  finanzaDocumentosExp008 ExpedienteFinanzaDocumento[]
  aplicado_por            User?                        @relation("MovimientoAplicado", fields: [aplicado_por_id], references: [id])
  cancelado_por           User?                        @relation("MovimientoCancelado", fields: [cancelado_por_id], references: [id])
  capturado_por           User                         @relation("MovimientoCapturado", fields: [capturado_por_id], references: [id])
  compareciente           Compareciente?               @relation(fields: [compareciente_id], references: [id])
  cotizacion              Cotizacion?                  @relation(fields: [cotizacion_id], references: [id])
  cuenta                  CuentaFinanciera?            @relation(fields: [cuenta_id], references: [id], onDelete: Restrict)
  expediente              Expediente?                  @relation(fields: [expediente_id], references: [id], onDelete: Restrict)
  movimientoOrigen        MovimientoFinanciero?        @relation("MovimientoReversoRel", fields: [movimiento_origen_id], references: [id], onDelete: Restrict)
  reversosGenerados       MovimientoFinanciero[]       @relation("MovimientoReversoRel")
  notaria                 Notaria?                     @relation(fields: [notaria_id], references: [id])
  responsable             User?                        @relation("MovimientoResponsable", fields: [responsable_id], references: [id])
  revertido_por           User?                        @relation("MovimientoRevertido", fields: [revertido_por_id], references: [id])
  validado_por            User?                        @relation("MovimientoValidado", fields: [validado_por_id], references: [id])

  @@index([fecha_movimiento, estatus])
  @@index([naturaleza, estatus])
  @@index([expediente_id, fecha_movimiento])
  @@index([cuenta_id, fecha_movimiento])
  @@index([notaria_id, fecha_movimiento])
  @@index([responsable_id, fecha_movimiento])
  @@index([capturado_por_id], map: "idx_movimientos_capturado_por_fk")
  @@index([cotizacion_id], map: "idx_movimientos_cotizacion_fk")
  @@index([expediente_id], map: "idx_movimientos_expediente_fk")
  @@index([aplicado_por_id], map: "idx_movimientos_financieros_aplicado_por_fk")
  @@index([cancelado_por_id], map: "idx_movimientos_financieros_cancelado_por_fk")
  @@index([compareciente_id], map: "idx_movimientos_financieros_compareciente_fk")
  @@index([movimiento_origen_id], map: "idx_movimientos_origen_fk")
  @@index([revertido_por_id], map: "idx_movimientos_revertido_por_fk")
  @@index([validado_por_id], map: "idx_movimientos_validado_por_fk")
  @@map("movimientos_financieros")
}

model CategoriaFinanciera {
  id                    String                        @id @default(uuid()) @db.Uuid
  organization_id       String?                       @db.Uuid
  clave                 String                        @unique
  nombre                String
  naturaleza            NaturalezaCategoriaFinanciera
  direccion             DireccionCategoriaFinanciera  @default(AMBAS)
  activa                Boolean                       @default(true)
  orden                 Int                           @default(0)
  created_at            DateTime                      @default(now())
  updated_at            DateTime                      @updatedAt
  distribuciones        MovimientoDistribucion[]
  solicitudesPagoExp008 ExpedienteSolicitudPago[]

  @@index([activa, orden])
  @@map("categorias_financieras")
}

model CuentaFinanciera {
  id                       String                       @id @default(uuid()) @db.Uuid
  organization_id          String?                      @db.Uuid
  institucion              String
  alias                    String
  tipo                     String
  ultimos_cuatro           String?
  moneda                   String                       @default("MXN")
