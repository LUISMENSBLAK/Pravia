  expediente                      Expediente                         @relation("Exp006PendingExpediente", fields: [expediente_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  expedienteActo                  ExpedienteActo?                    @relation("Exp006PendingAct", fields: [expediente_acto_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
