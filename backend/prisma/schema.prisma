model ComplianceEvidence {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  review_id       String           @db.Uuid
  documento_id    String           @db.Uuid
  tipo_evidencia  String
  observaciones   String?
  agregado_por_id String           @db.Uuid
  estatus         String           @default("ACTIVO")
  created_at      DateTime         @default(now())
  agregado_por    User             @relation("ComplianceEvidenceAdder", fields: [agregado_por_id], references: [id], onUpdate: NoAction)
  documento       Documento        @relation(fields: [documento_id], references: [id], onUpdate: NoAction)
  review          ComplianceReview @relation(fields: [review_id], references: [id], onUpdate: NoAction)

  @@unique([review_id, documento_id, tipo_evidencia])
  @@index([documento_id])
  @@index([agregado_por_id], map: "idx_compliance_evidence_agregado_fk")
  @@map("compliance_evidence")
}

model CargaTemporalDocumento {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alta_session_id        String                    @db.Uuid
  usuario_id             String                    @db.Uuid
  tipo_documento         String
  nombre_original        String
  storage_key_temporal   String
  mime_type              String
  tamano_bytes           Int
  sha256                 String
  estado                 CargaTemporalEstatus      @default(TEMPORAL)
  intentos_limpieza      Int                       @default(0)
  ultimo_error_limpieza  String?
  limpieza_programada_at DateTime?
  eliminado_storage_at   DateTime?
  expires_at             DateTime
  created_at             DateTime                  @default(now())
  updated_at             DateTime                  @default(now()) @updatedAt
  archived_at            DateTime?
  altaSession            ComparecienteAltaSession  @relation(fields: [alta_session_id], references: [id], onDelete: Cascade, map: "fk_carga_temporal_session")
  usuario                User                      @relation("CargaTemporalUsuario", fields: [usuario_id], references: [id], map: "fk_carga_temporal_usuario")
  datosFuente            ComparecienteDatoFuente[]
  compensationJobs       StorageCompensationJob[]

  @@index([estado], map: "idx_cargas_temporales_estado")
  @@index([alta_session_id], map: "idx_cargas_temporales_session")
  @@index([usuario_id], map: "idx_cargas_temporales_usuario")
  @@map("carga_temporal_documentos")
}

model StorageCompensationJob {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  carga_temporal_id    String?                    @db.Uuid
  storage_key          String
  tipo_operacion       String                     @default("ELIMINAR_TEMPORAL")
  estatus              StorageCompensationEstatus @default(PENDIENTE)
  intentos             Int                        @default(0)
  ultimo_error         String?
  proxima_ejecucion_at DateTime                   @default(now())
  correlation_id       String?
  created_at           DateTime                   @default(now())
  updated_at           DateTime                   @default(now()) @updatedAt
  cargaTemporal        CargaTemporalDocumento?    @relation(fields: [carga_temporal_id], references: [id], map: "fk_storage_job_carga_temporal")

  @@index([estatus, proxima_ejecucion_at], map: "idx_storage_compensation_jobs_estatus_exec")
  @@index([carga_temporal_id], map: "idx_storage_jobs_carga_fk")
  @@map("storage_compensation_jobs")
}

model ComparecienteDatoFuente {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compareciente_id    String                  @db.Uuid
  campo               String
  entidad_destino     String?
  registro_destino_id String?
  valor_detectado     String?
  valor_confirmado    String?
  documento_id        String?                 @db.Uuid
  carga_temporal_id   String?                 @db.Uuid
  pagina              Int?
  fragmento_fuente    String?
  proveedor_ia        String?
  modelo_ia           String?
  confianza           CalidadLectura?
  estado              DatoFuenteEstado        @default(DETECTADO)
  confirmado_por_id   String?                 @db.Uuid
  confirmado_at       DateTime?
  correlation_id      String?
  created_at          DateTime                @default(now())
  updated_at          DateTime                @default(now()) @updatedAt
  archived_at         DateTime?
  cargaTemporal       CargaTemporalDocumento? @relation(fields: [carga_temporal_id], references: [id], map: "fk_datos_fuente_carga_temporal")
  compareciente       Compareciente           @relation(fields: [compareciente_id], references: [id], map: "fk_datos_fuente_compareciente")
  confirmado_por      User?                   @relation("DatoFuenteConfirmador", fields: [confirmado_por_id], references: [id], map: "fk_datos_fuente_confirmador")
  documento           Documento?              @relation(fields: [documento_id], references: [id], map: "fk_datos_fuente_documento")

  @@index([carga_temporal_id], map: "idx_comp_datos_fuente_carga_fk")
  @@index([confirmado_por_id], map: "idx_comp_datos_fuente_confirmador_fk")
  @@index([documento_id], map: "idx_comp_datos_fuente_documento_fk")
  @@index([campo], map: "idx_compareciente_datos_fuente_campo")
  @@index([compareciente_id], map: "idx_compareciente_datos_fuente_comp")
  @@map("compareciente_datos_fuente")
}

model ComparecienteAlias {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compareciente_id String        @db.Uuid
  alias            String
  tipo             String?       @default("COMERCIAL_O_CONOCIDO")
  principal        Boolean       @default(false)
  activo           Boolean       @default(true)
  created_at       DateTime      @default(now())
  archived_at      DateTime?
  compareciente    Compareciente @relation(fields: [compareciente_id], references: [id], onDelete: Cascade, map: "fk_compareciente_aliases_comp")

  @@index([alias], map: "idx_compareciente_aliases_alias")
  @@index([compareciente_id], map: "idx_compareciente_aliases_comp")
  @@map("compareciente_aliases")
}

model ActividadEconomica {
  id                       String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clave                    String                            @unique
  descripcion              String
  sector                   String?
  vigente                  Boolean                           @default(true)
  created_at               DateTime                          @default(now())
  comparecienteActividades ComparecienteActividadEconomica[]

  @@index([clave], map: "idx_actividades_economicas_clave")
  @@index([descripcion], map: "idx_actividades_economicas_descripcion")
  @@map("actividades_economicas")
}

model ComparecienteActividadEconomica {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compareciente_id String             @db.Uuid
  actividad_id     String             @db.Uuid
  principal        Boolean            @default(true)
  fecha_inicio     DateTime?
  fecha_fin        DateTime?
  fuente           String?
  vigente          Boolean            @default(true)
  created_at       DateTime           @default(now())
  actividad        ActividadEconomica @relation(fields: [actividad_id], references: [id], map: "fk_comp_actividades_act")
  compareciente    Compareciente      @relation(fields: [compareciente_id], references: [id], onDelete: Cascade, map: "fk_comp_actividades_comp")

  @@unique([compareciente_id, actividad_id], map: "uq_compareciente_actividad")
  @@index([actividad_id], map: "idx_comp_actividades_actividad_fk")
  @@map("compareciente_actividades_economicas")
}

