  created_at                    DateTime @default(now())

  usuario                  User?                     @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  expediente               Expediente?               @relation(fields: [expediente_id], references: [id], onDelete: SetNull)
  comparecienteAltaSession ComparecienteAltaSession? @relation(fields: [compareciente_alta_session_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([modelo, created_at])
  @@index([usuario_id, created_at])
  @@index([expediente_id, created_at])
  @@map("ai_usage_logs")
}

model ComplianceRuleSet {
  id                  String    @id @default(uuid()) @db.Uuid
  tipo                String
  clave               String
  version             String
  nombre              String
  estatus             String    @default("BORRADOR")
  vigencia_desde      DateTime
  vigencia_hasta      DateTime?
  fuente_nombre       String
  fuente_url          String
  fuente_publicada_at DateTime?
  parametros          Json
  cuestionario        Json
  notas               String?
  creado_por_id       String    @db.Uuid
  aprobado_por_id     String?   @db.Uuid
  aprobado_at         DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  creado_por   User               @relation("ComplianceRuleCreator", fields: [creado_por_id], references: [id], onDelete: Restrict)
  aprobado_por User?              @relation("ComplianceRuleApprover", fields: [aprobado_por_id], references: [id], onDelete: SetNull)
  revisiones   ComplianceReview[]

  @@unique([tipo, clave, version])
  @@index([tipo, estatus, vigencia_desde])
  @@map("compliance_rule_sets")
}

model ComplianceReview {
  id                    String    @id @default(uuid()) @db.Uuid
  expediente_id         String    @db.Uuid
  rule_set_id           String    @db.Uuid
  tipo                  String
  estatus               String    @default("BORRADOR")
  fecha_operacion       DateTime?
  rule_version_snapshot String
  cuestionario_json     Json
  resultado_json        Json?
  explicacion           String?
  creado_por_id         String    @db.Uuid
  revisado_por_id       String?   @db.Uuid
  revisado_at           DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  expediente   Expediente           @relation(fields: [expediente_id], references: [id], onDelete: Restrict)
  ruleSet      ComplianceRuleSet    @relation(fields: [rule_set_id], references: [id], onDelete: Restrict)
  creado_por   User                 @relation("ComplianceReviewCreator", fields: [creado_por_id], references: [id], onDelete: Restrict)
  revisado_por User?                @relation("ComplianceReviewReviewer", fields: [revisado_por_id], references: [id], onDelete: SetNull)
  evidencias   ComplianceEvidence[]

  @@index([expediente_id, tipo])
  @@index([estatus, created_at])
  @@map("compliance_reviews")
}

model ComplianceEvidence {
  id              String   @id @default(uuid()) @db.Uuid
  review_id       String   @db.Uuid
  documento_id    String   @db.Uuid
  tipo_evidencia  String
  observaciones   String?
  agregado_por_id String   @db.Uuid
  estatus         String   @default("ACTIVO")
  created_at      DateTime @default(now())

  review       ComplianceReview @relation(fields: [review_id], references: [id], onDelete: Restrict)
  documento    Documento        @relation(fields: [documento_id], references: [id], onDelete: Restrict)
  agregado_por User             @relation("ComplianceEvidenceAdder", fields: [agregado_por_id], references: [id], onDelete: Restrict)

  @@unique([review_id, documento_id, tipo_evidencia])
  @@index([documento_id])
  @@map("compliance_evidence")
}

model CargaTemporalDocumento {
  id                     String               @id @default(uuid()) @db.Uuid
  alta_session_id        String               @db.Uuid
  usuario_id             String               @db.Uuid
  tipo_documento         String
  nombre_original        String
  storage_key_temporal   String
  mime_type              String
  tamano_bytes           Int
  sha256                 String
  estado                 CargaTemporalEstatus @default(TEMPORAL)
  intentos_limpieza      Int                  @default(0)
  ultimo_error_limpieza  String?
  limpieza_programada_at DateTime?
  eliminado_storage_at   DateTime?
  expires_at             DateTime
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  archived_at            DateTime?

  altaSession      ComparecienteAltaSession  @relation(fields: [alta_session_id], references: [id], onDelete: Cascade)
  usuario          User                      @relation("CargaTemporalUsuario", fields: [usuario_id], references: [id], onDelete: Restrict)
  compensationJobs StorageCompensationJob[]
  datosFuente      ComparecienteDatoFuente[]

  @@index([alta_session_id])
  @@index([usuario_id])
  @@index([estado])
  @@map("carga_temporal_documentos")
}

model StorageCompensationJob {
  id                   String                     @id @default(uuid()) @db.Uuid
  carga_temporal_id    String?                    @db.Uuid
  storage_key          String
  tipo_operacion       String                     @default("ELIMINAR_TEMPORAL")
  estatus              StorageCompensationEstatus @default(PENDIENTE)
  intentos             Int                        @default(0)
  ultimo_error         String?
  proxima_ejecucion_at DateTime                   @default(now())
  correlation_id       String?
  created_at           DateTime                   @default(now())
  updated_at           DateTime                   @updatedAt

  cargaTemporal CargaTemporalDocumento? @relation(fields: [carga_temporal_id], references: [id], onDelete: SetNull)

  @@index([estatus, proxima_ejecucion_at])
  @@map("storage_compensation_jobs")
}

model ComparecienteDatoFuente {
  id                  String           @id @default(uuid()) @db.Uuid
  compareciente_id    String           @db.Uuid
  campo               String
  entidad_destino     String?
  registro_destino_id String?
  valor_detectado     String?
  valor_confirmado    String?
  documento_id        String?          @db.Uuid
  carga_temporal_id   String?          @db.Uuid
  pagina              Int?
  fragmento_fuente    String?
  proveedor_ia        String?
  modelo_ia           String?
  confianza           CalidadLectura?
  estado              DatoFuenteEstado @default(DETECTADO)
  confirmado_por_id   String?          @db.Uuid
  confirmado_at       DateTime?
  correlation_id      String?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  archived_at         DateTime?

  compareciente  Compareciente           @relation(fields: [compareciente_id], references: [id], onDelete: Restrict)
  documento      Documento?              @relation(fields: [documento_id], references: [id], onDelete: SetNull)
  cargaTemporal  CargaTemporalDocumento? @relation(fields: [carga_temporal_id], references: [id], onDelete: SetNull)
  confirmado_por User?                   @relation("DatoFuenteConfirmador", fields: [confirmado_por_id], references: [id], onDelete: SetNull)

  @@index([compareciente_id])
  @@index([campo])
  @@map("compareciente_datos_fuente")
}

model ComparecienteAlias {
  id               String    @id @default(uuid()) @db.Uuid
  compareciente_id String    @db.Uuid
  alias            String
  tipo             String?   @default("COMERCIAL_O_CONOCIDO")
  principal        Boolean   @default(false)
  activo           Boolean   @default(true)
  created_at       DateTime  @default(now())
  archived_at      DateTime?

  compareciente Compareciente @relation(fields: [compareciente_id], references: [id], onDelete: Cascade)

  @@index([compareciente_id])
  @@index([alias])
  @@map("compareciente_aliases")
}

model ActividadEconomica {
  id          String   @id @default(uuid()) @db.Uuid
  clave       String   @unique
  descripcion String
  sector      String?
  vigente     Boolean  @default(true)
  created_at  DateTime @default(now())

  comparecienteActividades ComparecienteActividadEconomica[]

  @@index([clave])
  @@index([descripcion])
  @@map("actividades_economicas")
}

model ComparecienteActividadEconomica {
  id               String    @id @default(uuid()) @db.Uuid
  compareciente_id String    @db.Uuid
  actividad_id     String    @db.Uuid
  principal        Boolean   @default(true)
  fecha_inicio     DateTime?
  fecha_fin        DateTime?
  fuente           String?
  vigente          Boolean   @default(true)
  created_at       DateTime  @default(now())

  compareciente Compareciente      @relation(fields: [compareciente_id], references: [id], onDelete: Cascade)
  actividad     ActividadEconomica @relation(fields: [actividad_id], references: [id], onDelete: Restrict)

  @@unique([compareciente_id, actividad_id])
  @@map("compareciente_actividades_economicas")
}
