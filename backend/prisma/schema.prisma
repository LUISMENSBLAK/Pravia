  updated_at                      DateTime                        @default(now()) @updatedAt
  checklist                       ChecklistItem[]
  configuracionesOperativas       ConfiguracionActo[]
  expedientes                     Expediente[]
  expedienteActos                 ExpedienteActo[]
  flujoEtapas                     FlujoEtapa[]
  flujoVersiones                  FlujoVersion[]
  formularioSecciones             FormularioSeccion[]
  formularioVersiones             FormularioVersion[]
  plantillaDocVersiones           PlantillaDocumentalVersion[]
  serviciosProspecto              ProspectoServicioCatalogo[]
  tipoActoCaracteresCompareciente TipoActoCaracterCompareciente[]

  @@map("tipos_acto")
}

model FormularioSeccion {
  id           String            @id @default(uuid()) @db.Uuid
  tipo_acto_id String            @db.Uuid
  clave        String
  titulo       String
  orden        Int               @default(0)
  descripcion  String?
  campos       FormularioCampo[]
