  confirmado_por      User?                   @relation("DatoFuenteConfirmador", fields: [confirmado_por_id], references: [id], map: "fk_datos_fuente_confirmador")
  documento           Documento?              @relation(fields: [documento_id], references: [id], map: "fk_datos_fuente_documento")

  @@index([carga_temporal_id], map: "idx_comp_datos_fuente_carga_fk")
  @@index([confirmado_por_id], map: "idx_comp_datos_fuente_confirmador_fk")
  @@index([documento_id], map: "idx_comp_datos_fuente_documento_fk")
  @@index([campo], map: "idx_compareciente_datos_fuente_campo")
  @@index([compareciente_id], map: "idx_compareciente_datos_fuente_comp")
  @@map("compareciente_datos_fuente")
}

model ComparecienteAlias {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String?       @db.Uuid
  compareciente_id String        @db.Uuid
  alias            String
  tipo             String?       @default("COMERCIAL_O_CONOCIDO")
  principal        Boolean       @default(false)
  activo           Boolean       @default(true)
  created_at       DateTime      @default(now())
  archived_at      DateTime?
  compareciente    Compareciente @relation(fields: [compareciente_id], references: [id], onDelete: Cascade, map: "fk_compareciente_aliases_comp")

  @@index([alias], map: "idx_compareciente_aliases_alias")
  @@index([compareciente_id], map: "idx_compareciente_aliases_comp")
  @@map("compareciente_aliases")
}

model ActividadEconomica {
  id                       String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clave                    String                            @unique
  descripcion              String
  sector                   String?
  vigente                  Boolean                           @default(true)
  created_at               DateTime                          @default(now())
  comparecienteActividades ComparecienteActividadEconomica[]

  @@index([clave], map: "idx_actividades_economicas_clave")
  @@index([descripcion], map: "idx_actividades_economicas_descripcion")
  @@map("actividades_economicas")
}

model ComparecienteActividadEconomica {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String?            @db.Uuid
  compareciente_id String             @db.Uuid
  actividad_id     String             @db.Uuid
  principal        Boolean            @default(true)
  fecha_inicio     DateTime?
  fecha_fin        DateTime?
  fuente           String?
  vigente          Boolean            @default(true)
  created_at       DateTime           @default(now())
  actividad        ActividadEconomica @relation(fields: [actividad_id], references: [id], map: "fk_comp_actividades_act")
  compareciente    Compareciente      @relation(fields: [compareciente_id], references: [id], onDelete: Cascade, map: "fk_comp_actividades_comp")

  @@unique([compareciente_id, actividad_id], map: "uq_compareciente_actividad")
  @@index([actividad_id], map: "idx_comp_actividades_actividad_fk")
  @@map("compareciente_actividades_economicas")
}

