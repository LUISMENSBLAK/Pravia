# Same-origin en frontend. En desarrollo/preview, Vite puede resolver /api
# mediante LOCAL_API_PROXY_TARGET sin exponer ese destino al bundle.
VITE_API_BASE_URL=/api
LOCAL_API_PROXY_TARGET=http://localhost:3001
# Para un deploy staging real: staging + host exacto de su backend HTTPS.
# El build falla si apunta a localhost, usa HTTP o coincide con un host productivo.
VITE_DEPLOY_ENV=development
VITE_EXPECTED_API_HOST=
VITE_PRODUCTION_API_HOSTS=
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_REFRESH_PATH=/auth/refresh
VITE_AUTH_ME_PATH=/auth/me
VITE_AUTH_LOGOUT_PATH=/auth/logout
VITE_MY_DAY_PATH=/dashboard/mi-dia
# La conversación tiene un contrato backend estable; el resto sigue siendo opcional.
VITE_ASSISTANT_MESSAGE_PATH=/ia/assistant/messages
VITE_ASSISTANT_SUGGESTIONS_PATH=
VITE_ASSISTANT_CONFIRM_PATH=
VITE_ASSISTANT_DISMISS_PATH=
VITE_ASSISTANT_SNOOZE_PATH=
